@model List<hrms_mvc.Models.Attendance>

@{
    ViewData["Title"] = "Attendance";
}

<div class="container-fluid">


    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">Attendance</h4>
            <p class="text-muted mb-0">
                Manage employee attendance
            </p>
        </div>

        <a asp-controller="AdminAttendance"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Add Attendance
        </a>
    </div>


    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <form asp-controller="AdminAttendance"
                  asp-action="FilterAttendance"
                  method="get">

                <div class="row g-3 align-items-end">


                    <div class="col-md-4">
                        <label class="form-label">
                            Start Date
                        </label>

                        <input type="date"
                               name="startDate"
                               class="form-control" />
                    </div>



                    <div class="col-md-4">
                        <label class="form-label">
                            End Date
                        </label>

                        <input type="date"
                               name="endDate"
                               class="form-control" />
                    </div>



                    <div class="col-md-4">

                        <button type="submit"
                                class="btn btn-primary me-2">
                            <i class="bi bi-search"></i>
                            Search
                        </button>

                        <a asp-controller="AdminAttendance"
                           asp-action="AdminAttendanceList"
                           class="btn btn-secondary">
                            Reset
                        </a>

                    </div>

                </div>

            </form>

        </div>
    </div>

\
    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }



    <div class="card shadow-sm">

        <div class="card-header bg-white">
            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0">
                    Attendance Details
                </h5>

            </div>
        </div>


        <div class="card-body">

            <div class="table-responsive">

                <table id="attendanceTable"
                       class="table table-bordered table-hover align-middle">

                    <thead class="table-light">

                        <tr>
                            <th>Sr. No.</th>
                            <th>Employee</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>

                    </thead>


                    <tbody>

                        @if (Model != null && Model.Count > 0)
                        {
                            int srNo = 1;

                            foreach (var attendance in Model)
                            {
                                <tr>

                                
                                    <td>
                                        @srNo
                                    </td>


                      
                                    <td>
                                        @if (attendance.User != null)
                                        {
                                            @attendance.User.FirstName
                                            @attendance.User.LastName
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Employee not found
                                            </span>
                                        }
                                    </td>


                                    <td>
                                        @attendance.Date.ToString("dd-MM-yyyy")
                                    </td>


                                    <td>

                                        <a asp-controller="AdminAttendance"
                                           asp-action="Details"
                                           asp-route-id="@attendance.Id"
                                           class="btn btn-sm btn-info text-white me-1"
                                           title="View">

                                            <i class="bi bi-eye"></i>

                                        </a>


                                        <a asp-controller="AdminAttendance"
                                           asp-action="Edit"
                                           asp-route-id="@attendance.Id"
                                           class="btn btn-sm btn-warning me-1"
                                           title="Edit">

                                            <i class="bi bi-pencil"></i>

                                        </a>



                                        <form asp-controller="AdminAttendance"
                                              asp-action="Delete"
                                              asp-route-id="@attendance.Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-danger"
                                                    title="Delete"
                                                    onclick="return confirm('Are you sure you want to delete this attendance record?');">

                                                <i class="bi bi-trash"></i>

                                            </button>

                                        </form>

                                    </td>

                                </tr>

                                srNo++;
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="4"
                                    class="text-center text-muted py-4">

                                    No attendance records found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <!-- DataTables -->
    <link rel="stylesheet"
          href="https://cdn.datatables.net/2.0.8/css/dataTables.bootstrap5.css" />

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.js"></script>

    <script src="https://cdn.datatables.net/2.0.8/js/dataTables.bootstrap5.js"></script>


    <script>

        $(document).ready(function() {

            $('#attendanceTable').DataTable({
                pageLength: 10,
                ordering: true,
                searching: true,
                lengthChange: true,
                responsive: true
            });

        });

    </script>
}