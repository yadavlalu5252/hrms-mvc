@model hrms_mvc.Models.Attendance

@{
    ViewData["Title"] = "Edit Attendance";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h4 class="mb-1">Edit Attendance</h4>

            <p class="text-muted mb-0">
                Update employee attendance
            </p>
        </div>

        <a asp-action="AdminAttendanceList"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left"></i>
            Back

        </a>

    </div>


    <div class="card shadow-sm">

        <div class="card-header bg-white">

            <h5 class="mb-0">
                Attendance Details
            </h5>

        </div>


        <div class="card-body">

            <form asp-action="Edit"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="Id" />


                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="row g-3">

                    <!-- Employee -->
                    <div class="col-md-6">

                        <label asp-for="UserId"
                               class="form-label">
                            Employee
                        </label>

                        <select asp-for="UserId"
                                class="form-select"
                                required>

                            <option value="">
                                -- Select Employee --
                            </option>

                            @foreach (var employee in ViewBag.Employees)
                            {
                                <option value="@employee.Id">
                                    @employee.FirstName @employee.LastName
                                </option>
                            }

                        </select>

                    </div>


                    <!-- Date -->
                    <div class="col-md-6">

                        <label asp-for="Date"
                               class="form-label">
                            Attendance Date
                        </label>

                        <input asp-for="Date"
                               type="date"
                               class="form-control"
                               required />

                    </div>

                </div>


                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-save"></i>
                        Update Attendance

                    </button>

                    <a asp-action="AdminAttendanceList"
                       class="btn btn-secondary ms-2">

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}