@model hrms_mvc.Models.Attendance

@{
    ViewData["Title"] = "Add Attendance";
}

<div class="container-fluid">


    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h4 class="mb-1">Add Attendance</h4>

            <p class="text-muted mb-0">
                Add employee attendance details
            </p>
        </div>

        <a asp-controller="AdminAttendance"
           asp-action="AdminAttendanceList"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left"></i>
            Back

        </a>

    </div>



    <div class="card shadow-sm">

        <div class="card-header bg-white">

            <h5 class="mb-0">
                Attendance Details
            </h5>

        </div>


        <div class="card-body">

            <form asp-controller="AdminAttendance"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()


                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="row g-3">

                  
                    <div class="col-md-6">

                        <label asp-for="UserId"
                               class="form-label">
                            Employee
                        </label>

                        <select asp-for="UserId"
                                class="form-select"
                                required>

                            <option value="">
                                -- Select Employee --
                            </option>

                            @foreach (var employee in ViewBag.Employees)
                            {
                                <option value="@employee.Id">
                                    @employee.FirstName @employee.LastName
                                </option>
                            }

                        </select>

                        <span asp-validation-for="UserId"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Date -->
                    <div class="col-md-6">

                        <label asp-for="Date"
                               class="form-label">
                            Attendance Date
                        </label>

                        <input asp-for="Date"
                               type="date"
                               class="form-control"
                               required />

                        <span asp-validation-for="Date"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-circle"></i>
                        Save Attendance

                    </button>


                    <a asp-controller="AdminAttendance"
                       asp-action="AdminAttendanceList"
                       class="btn btn-secondary ms-2">

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}