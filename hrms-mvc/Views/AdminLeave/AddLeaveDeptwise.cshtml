@{
}

@{
    ViewBag.Title = "Allocate Leave Deptwise";
}

<div class="card">
    <div class="card-body">
        <h2 class="mb-4">Allocate Leave Deptwise</h2>
        <form method="post" asp-action="AddLeaveDeptwise">
            <div class="mb-4">
                <label class="form-label">Select Department</label>
                <select name="departmentId" class="form-control" required>
                    <option value="">Select Department</option>
                    @foreach (var department in ViewBag.Departments)
                    {
                        <option value="@department.Id">@department.Name</option>
                    }
                </select>
            </div>
            <div class="mb-4">
                <label class="form-label">Select Leave Type</label>
                <select name="leaveTypeId" class="form-control" required>
                    <option value="">Select Leave Type</option>
                    @foreach (var leaveType in ViewBag.LeaveTypes)
                    {
                        <option value="@leaveType.Value">@leaveType.Text</option>
                    }
                </select>
            </div>
            <div class="mb-4">
                <label class="form-label">Number of Leaves Allocated</label>
                <input type="number" name="leavesCount" class="form-control" min="1" required />
            </div>
            <button type="submit" class="btn btn-primary">Allocate Leave</button>
        </form>
    </div>
</div>

@if (TempData["success"] != null)
{
    <div class="alert alert-success mt-3">@TempData["success"]</div>
}

@if (TempData["error"] != null)
{
    <div class="alert alert-danger mt-3">@TempData["error"]</div>
}