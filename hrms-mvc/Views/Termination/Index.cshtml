@model List<hrms_mvc.Models.Termination>

@{
    var role = Context.Session.GetString("Role");

    if (role == "Admin")
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    else if (role == "Employee")
    {
        Layout = "~/Views/Shared/_EmployeeLayout.cshtml";
    }
    else if (role == "Manager")
    {
        Layout = "~/Views/Shared/_ManagerLayout.cshtml";
    }
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Termination</h2>

        <button type="button"
                class="btn"
                style="background-color: #F26522; color: white;"
                data-bs-toggle="modal"
                data-bs-target="#addTerminationModal">
            Add Termination
        </button>
    </div>

    <div class="card">

        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">

            <h5 class="mb-0">Termination List</h5>

            <div class="d-flex align-items-center gap-2 flex-wrap">

                <select id="dateFilter"
                        class="form-select"
                        style="width: 150px;">

                    <option value="">All Records</option>
                    <option value="asc">Oldest First</option>
                    <option value="desc">Newest First</option>

                </select>

                <select id="sortFilter"
                        class="form-select"
                        style="width: 130px;">

                    <option value="">Sort By</option>
                    <option value="asc">Ascending</option>
                    <option value="desc">Descending</option>

                </select>

                <div class="dropdown">

                    <button type="button"
                            class="btn dropdown-toggle"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                        Export
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end">

                        <li>
                            <button type="button"
                                    class="dropdown-item"
                                    id="exportPdf">
                                Export as PDF
                            </button>
                        </li>

                        <li>
                            <button type="button"
                                    class="dropdown-item"
                                    id="exportExcel">
                                Export as Excel
                            </button>
                        </li>

                    </ul>

                </div>

            </div>

        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table id="terminationTable"
                       class="table table-bordered table-hover align-middle w-100">

                    <thead class="table-light">

                        <tr>
                            <th>Employee Name</th>
                            <th>Termination Type</th>
                            <th>Notice Date</th>
                            <th>Resign Date</th>
                            <th>Reason</th>
                            <th>Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    @if (item.User != null)
                                    {
                                        @item.User.FirstName @item.User.LastName
                                    }
                                </td>

                                <td>
                                    @item.TerminationType
                                </td>

                                <td>
                                    @item.NoticeDate.ToString("yyyy-MM-dd")
                                </td>

                                <td>
                                    @item.ResignDate.ToString("yyyy-MM-dd")
                                </td>

                                <td>
                                    @item.Reason
                                </td>

                                <td>

                                    <button type="button"
                                            class="btn btn-sm editTerminationButton"
                                            data-id="@item.TerminationId"
                                            data-userid="@item.UserId"
                                            data-terminationtype="@item.TerminationType"
                                            data-noticedate="@item.NoticeDate.ToString("yyyy-MM-dd")"
                                            data-resigndate="@item.ResignDate.ToString("yyyy-MM-dd")"
                                            data-reason="@item.Reason"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editTerminationModal"
                                            title="Edit">

                                        <i class="bi bi-pencil-square"></i>

                                    </button>

                                    <form asp-controller="Termination"
                                          asp-action="DeleteTermination"
                                          asp-route-id="@item.TerminationId"
                                          method="post"
                                          style="display: inline;">

                                        <button type="submit"
                                                class="btn btn-sm"
                                                onclick="return confirm('Are you sure you want to delete this termination?');"
                                                title="Delete">

                                            <i class="bi bi-trash"></i>

                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<div class="modal fade"
     id="addTerminationModal"
     tabindex="-1"
     aria-labelledby="addTerminationModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title" id="addTerminationModalLabel">
                    Add Termination
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <form asp-controller="Termination"
                  asp-action="AddTermination"
                  method="post">

                <div class="modal-body">

                    <div class="mb-3">

                        <label for="UserId" class="form-label">
                            Employee
                        </label>

                        <select id="UserId"
                                name="UserId"
                                class="form-select"
                                required>

                            <option value="">Select Employee</option>

                            @if (ViewBag.Users != null)
                            {
                                foreach (var user in ViewBag.Users)
                                {
                                    <option value="@user.Id">
                                        @user.FirstName @user.LastName
                                    </option>
                                }
                            }

                        </select>

                        <span class="text-danger">
                            @Html.ValidationMessage("UserId")
                        </span>

                    </div>

                    <div class="mb-3">

                        <label for="TerminationType" class="form-label">
                            Termination Type
                        </label>

                        <select id="TerminationType"
                                name="TerminationType"
                                class="form-select"
                                required>

                            <option value="">Select Termination Type</option>
                            <option value="Voluntary">Voluntary</option>
                            <option value="Involuntary">Involuntary</option>
                            <option value="Performance">Performance</option>
                            <option value="Misconduct">Misconduct</option>
                            <option value="Other">Other</option>

                        </select>

                        <span class="text-danger">
                            @Html.ValidationMessage("TerminationType")
                        </span>

                    </div>

                    <div class="mb-3">

                        <label for="NoticeDate" class="form-label">
                            Notice Date
                        </label>

                        <input type="date"
                               id="NoticeDate"
                               name="NoticeDate"
                               class="form-control"
                               required />

                        <span class="text-danger">
                            @Html.ValidationMessage("NoticeDate")
                        </span>

                    </div>

                    <div class="mb-3">

                        <label for="ResignDate" class="form-label">
                            Resign Date
                        </label>

                        <input type="date"
                               id="ResignDate"
                               name="ResignDate"
                               class="form-control"
                               required />

                        <span class="text-danger">
                            @Html.ValidationMessage("ResignDate")
                        </span>

                    </div>

                    <div class="mb-3">

                        <label for="Reason" class="form-label">
                            Reason
                        </label>

                        <textarea id="Reason"
                                  name="Reason"
                                  class="form-control"
                                  rows="4"
                                  maxlength="500"
                                  required></textarea>

                        <span class="text-danger">
                            @Html.ValidationMessage("Reason")
                        </span>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn"
                            style="background-color: #F26522; color: white;">
                        Submit
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<div class="modal fade"
     id="editTerminationModal"
     tabindex="-1"
     aria-labelledby="editTerminationModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title" id="editTerminationModalLabel">
                    Edit Termination
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <form asp-controller="Termination"
                  asp-action="EditTermination"
                  method="post"
                  novalidate>

                <div class="modal-body">

                    <input type="hidden"
                           id="editTerminationId"
                           name="TerminationId" />

                    <div class="mb-3">

                        <label for="editTerminationUserId"
                               class="form-label">
                            Employee
                        </label>

                        <select id="editTerminationUserId"
                                name="UserId"
                                class="form-select"
                                required>

                            <option value="">Select Employee</option>

                            @if (ViewBag.Users != null)
                            {
                                foreach (var user in ViewBag.Users)
                                {
                                    <option value="@user.Id">
                                        @user.FirstName @user.LastName
                                    </option>
                                }
                            }

                        </select>

                        <span class="text-danger">
                            @Html.ValidationMessage("UserId")
                        </span>

                    </div>

                    <div class="mb-3">

                        <label for="editTerminationType"
                               class="form-label">
                            Termination Type
                        </label>

                        <select id="editTerminationType"
                                name="TerminationType"
                                class="form-select"
                                required>

                            <option value="">Select Termination Type</option>
                            <option value="Voluntary">Voluntary</option>
                            <option value="Involuntary">Involuntary</option>
                            <option value="Performance">Performance</option>
                            <option value="Misconduct">Misconduct</option>
                            <option value="Other">Other</option>

                        </select>

                        <span class="text-danger">
                            @Html.ValidationMessage("TerminationType")
                        </span>

                    </div>

                    <div class="mb-3">

                        <label for="editTerminationNoticeDate"
                               class="form-label">
                            Notice Date
                        </label>

                        <input type="date"
                               id="editTerminationNoticeDate"
                               name="NoticeDate"
                               class="form-control"
                               required />

                        <span class="text-danger">
                            @Html.ValidationMessage("NoticeDate")
                        </span>

                    </div>

                    <div class="mb-3">

                        <label for="editTerminationResignDate"
                               class="form-label">
                            Resign Date
                        </label>

                        <input type="date"
                               id="editTerminationResignDate"
                               name="ResignDate"
                               class="form-control"
                               required />

                        <span class="text-danger">
                            @Html.ValidationMessage("ResignDate")
                        </span>

                    </div>

                    <div class="mb-3">

                        <label for="editTerminationReason"
                               class="form-label">
                            Reason
                        </label>

                        <textarea id="editTerminationReason"
                                  name="Reason"
                                  class="form-control"
                                  rows="4"
                                  maxlength="500"
                                  required></textarea>

                        <span class="text-danger">
                            @Html.ValidationMessage("Reason")
                        </span>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn"
                            style="background-color: #F26522; color: white;">
                        Update Termination
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>

    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>

    <script>

        $(document).ready(function () {

            var table = $('#terminationTable').DataTable({

                pageLength: 5,

                order: [[2, 'asc']],

                dom:
                    '<"row mb-3"<"col-md-6"l><"col-md-6"f>>' +
                    'rt' +
                    '<"row mt-3"<"col-md-6"i><"col-md-6"p>>',

                buttons: [

                    {
                        extend: 'excelHtml5',
                        title: 'Termination List',
                        className: 'export-excel'
                    },

                    {
                        extend: 'pdfHtml5',
                        title: 'Termination List',
                        orientation: 'landscape',
                        pageSize: 'A4',
                        className: 'export-pdf'
                    }

                ]

            });

            $('.dt-buttons').hide();

            $('#dateFilter').on('change', function () {

                var dateValue = $(this).val();

                if (dateValue !== '') {
                    table.order([2, dateValue]).draw();
                }

            });

            $('#sortFilter').on('change', function () {

                var sortValue = $(this).val();

                if (sortValue !== '') {
                    table.order([0, sortValue]).draw();
                }

            });

            $('#exportExcel').on('click', function () {

                table.button('.export-excel').trigger();

            });

            $('#exportPdf').on('click', function () {

                table.button('.export-pdf').trigger();

            });

            $('.editTerminationButton').on('click', function () {

                var id = $(this).data('id');
                var userid = $(this).data('userid');
                var terminationtype = $(this).data('terminationtype');
                var noticedate = $(this).data('noticedate');
                var resigndate = $(this).data('resigndate');
                var reason = $(this).data('reason');

                $('#editTerminationId').val(id);
                $('#editTerminationUserId').val(userid);
                $('#editTerminationType').val(terminationtype);
                $('#editTerminationNoticeDate').val(noticedate);
                $('#editTerminationResignDate').val(resigndate);
                $('#editTerminationReason').val(reason);

            });

        });

    </script>
}