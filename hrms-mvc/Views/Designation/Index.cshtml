@model List<hrms_mvc.Models.Designation>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Designation";
}

<link rel="stylesheet"
      href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />

<link rel="stylesheet"
      href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css" />
<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<div class="container-fluid">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Designation</h2>

        <button type="button"
                class="btn"
                style="background-color: #F26522; color: white;"
                data-bs-toggle="modal"
                data-bs-target="#addDesignationModal">
            Add Designation
        </button>
    </div>

    <!-- Designation Card -->
    <div class="card">

        <!-- Card Header -->
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">

            <h5 class="mb-0">Designation List</h5>

            <div class="d-flex align-items-center gap-2 flex-wrap">

                <!-- Status Filter -->
                <select id="statusFilter"
                        class="form-select"
                        style="width: 130px;">

                    <option value="">All Status</option>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>

                <!-- Sorting Filter -->
                <select id="sortFilter"
                        class="form-select"
                        style="width: 130px;">

                    <option value="">Sort By</option>
                    <option value="asc">Ascending</option>
                    <option value="desc">Descending</option>
                </select>

                <!-- Export Dropdown -->
                <div class="dropdown">

                    <button type="button"
                            class="btn dropdown-toggle"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                        Export
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end">

                        <li>
                            <button type="button"
                                    class="dropdown-item"
                                    id="exportPdf">
                                Export as PDF
                            </button>
                        </li>

                        <li>
                            <button type="button"
                                    class="dropdown-item"
                                    id="exportExcel">
                                Export as Excel
                            </button>
                        </li>

                    </ul>
                </div>

            </div>
        </div>

        <!-- Card Body -->
        <div class="card-body">

            <div class="table-responsive">

                <table id="designationTable"
                       class="table table-bordered table-hover align-middle w-100">

                    <thead class="table-light">
                        <tr>
                            <th>Id</th>
                            <th>Designation Name</th>
                            <th>Department Name</th>
                            <th>No Of Employee</th>
                            <th>Status</th>
                            <th>Created By</th>
                            <th>Modified By</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>

                                <td>@item.DesignationName</td>
                                <td>@item.Department?.Name</td>

                                <td>@item.NoOfEmployee</td>

                                <td>
                                    @if (item.Status == "Active")
                                    {
                                        <span class="badge bg-success">
                                            ● Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            ● Inactive
                                        </span>
                                    }
                                </td>

                                <td>@item.CreatedBy</td>

                                <td>@item.ModifiedBy</td>

                                <td>
                                    <!-- Edit Button -->
                                    <button type="button"
                                            class="btn btn-sm editDesignationButton"
                                            data-id="@item.Id"
                                            data-designation-name="@item.DesignationName"
                                            data-department-id="@item.DepartmentId"
                                            data-status="@item.Status"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editDesignationModal"
                                            title="Edit">

                                        <i class="bi bi-pencil-square"></i>
                                    </button>

                                    <!-- Delete Button -->
                                    <form asp-controller="Designation"
                                          asp-action="DeleteDesignation"
                                          asp-route-id="@item.Id"
                                          method="post"
                                          style="display: inline;">

                                        <button type="submit"
                                                class="btn btn-sm"
                                                onclick="return confirm('Are you sure you want to delete this Designation?');"
                                                title="Delete">

                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        </div>
    </div>
</div>


<!-- Add Designation Modal -->
<div class="modal fade"
     id="addDesignationModal"
     tabindex="-1"
     aria-labelledby="addDesignationModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="addDesignationModalLabel">
                    Add Designation
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <form asp-controller="Designation"
                  asp-action="AddDesignation"
                  method="post"
                  novalidate>

                <div class="modal-body">

                    <div class="mb-3">
                        <label for="DesignationName" class="form-label">
                            Designation Name
                        </label>

                        <input type="text"
                               id="DesignationName"
                               name="DesignationName"
                               class="form-control"
                               placeholder="Enter Designation name"
                               required />

                        <span class="text-danger">
                            @Html.ValidationMessage("DesignationName")
                        </span>
                    </div>

                    <div class="mb-3">
                        <label for="DepartmentId" class="form-label">
                            Department
                        </label>

                        <select id="DepartmentId"
                                name="DepartmentId"
                                class="form-select"
                                required>

                            <option value="">Select Department</option>

                            @foreach (var department in ViewBag.Departments)
                            {
                                <option value="@department.Id">
                                    @department.Name
                                </option>
                            }
                        </select>

                        <span class="text-danger">
                            @Html.ValidationMessage("DepartmentId")
                        </span>
                    </div>

                    <div class="mb-3">
                        <label for="Status" class="form-label">
                            Status
                        </label>

                        <select id="Status"
                                name="Status"
                                class="form-select"
                                required>

                            <option value="">Select</option>
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>

                        <span class="text-danger">
                            @Html.ValidationMessage("Status")
                        </span>
                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn"
                            style="background-color: #F26522; color: white;">
                        Add Designation
                    </button>

                </div>
            </form>

        </div>
    </div>
</div>


@* Edit Designation Modal *@
<div class="modal fade"
     id="editDesignationModal"
     tabindex="-1"
     aria-labelledby="editDesignationModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="editDesignationModalLabel">
                    Edit Designation
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <form asp-controller="Designation"
                  asp-action="EditDesignation"
                  method="post"
                  novalidate>

                <div class="modal-body">

                    <input type="hidden"
                           id="editDesignationId"
                           name="Id" />

                    <div class="mb-3">
                        <label for="editDesignationName"
                               class="form-label">
                            Designation Name
                        </label>

                        <input type="text"
                               id="editDesignationName"
                               name="DesignationName"
                               class="form-control"
                               placeholder="Enter Designation name"
                               required />

                        <span class="text-danger">
                            @Html.ValidationMessage("DesignationName")
                        </span>
                    </div>

                    <div class="mb-3">
                        <label for="editDepartmentId"
                               class="form-label">
                            Department
                        </label>

                        <select id="editDepartmentId"
                                name="DepartmentId"
                                class="form-select"
                                required>

                            <option value="">Select Department</option>

                            @foreach (var department in ViewBag.Departments)
                            {
                                <option value="@department.Id">
                                    @department.Name
                                </option>
                            }
                        </select>

                        <span class="text-danger">
                            @Html.ValidationMessage("DepartmentId")
                        </span>
                    </div>

                    <div class="mb-3">
                        <label for="editDesignationStatus"
                               class="form-label">
                            Status
                        </label>

                        <select id="editDesignationStatus"
                                name="Status"
                                class="form-select"
                                required>

                            <option value="">Select</option>
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>

                        <span class="text-danger">
                            @Html.ValidationMessage("Status")
                        </span>
                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn"
                            style="background-color: #F26522; color: white;">
                        Update Designation
                    </button>

                </div>
            </form>

        </div>
    </div>
</div>


@section Scripts {

    <!-- DataTables Core -->
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>

    <!-- DataTables Buttons -->
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>

    <!-- Excel Export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

    <!-- PDF Export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

    <!-- HTML5 Export -->
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>

    <script>
        $(document).ready(function() {

            var table = $('#designationTable').DataTable({

                pageLength: 5,

                order: [[1, 'asc']],

                dom:
                    '<"row mb-3"<"col-md-6"l><"col-md-6"f>>' +
                    'rt' +
                    '<"row mt-3"<"col-md-6"i><"col-md-6"p>>',

                buttons: [
                    {
                        extend: 'excelHtml5',
                        title: 'Designation List',
                        className: 'export-excel'
                    },
                    {
                        extend: 'pdfHtml5',
                        title: 'Designation List',
                        orientation: 'landscape',
                        pageSize: 'A4',
                        className: 'export-pdf'
                    }
                ]
            });

            // Hide original DataTables export buttons
            $('.dt-buttons').hide();


            // Status Filter
            $('#statusFilter').on('change', function() {

                var status = $(this).val();

                if (status === '') {

                    table.column(4).search('').draw();

                } else {

                    var exactStatus = '^\\s*[●•]?\\s*' + status + '\\s*$';

                    table.column(4)
                        .search(exactStatus, true, false)
                        .draw();
                }
            });


            // Sort by Designation Name
            $('#sortFilter').on('change', function() {

                var sortValue = $(this).val();

                if (sortValue !== '') {
                    table.order([1, sortValue]).draw();
                }
            });


            // Export as Excel
            $('#exportExcel').on('click', function() {
                table.button('.export-excel').trigger();
            });


            // Export as PDF
            $('#exportPdf').on('click', function() {
                table.button('.export-pdf').trigger();
            });


            // Fill Edit Modal
            $(document).on('click', '.editDesignationButton', function() {

                var id = $(this).attr('data-id');
                var designationName = $(this).attr('data-designation-name');
                var departmentId = $(this).attr('data-department-id');
                var status = $(this).attr('data-status');

                $('#editDesignationId').val(id);
                $('#editDesignationName').val(designationName);
                $('#editDepartmentId').val(departmentId);
                $('#editDesignationStatus').val(status);
            });

        });
    </script>
}