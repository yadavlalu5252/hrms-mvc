@model hrms_mvc.Models.MasterDocEmp

<div class="main-wrapper">
    <div class="card p-4">

        <h3 class="mb-4">
            Edit Employee Document Name
        </h3>

        <form asp-controller="MasterDocEmp"
              asp-action="UpdateEmpDoc"
              method="post">

            <input type="hidden"
                   asp-for="EmpId" />

            <div class="mb-3">

                <label class="form-label">
                    Document Name
                </label>

                <input type="text"
                       class="form-control"
                       asp-for="EmpDocName"
                       placeholder="Enter Document Name">

                <span asp-validation-for="EmpDocName"
                      class="text-danger"></span>

            </div>

            <div class="d-flex justify-content-end">

                <a asp-controller="MasterDocEmp"
                   asp-action="FetchAllEmpDoc"
                   class="btn btn-light me-2">
                    Cancel
                </a>

                <button type="submit"
                        class="btn btn-primary">
                    Update
                </button>

            </div>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}