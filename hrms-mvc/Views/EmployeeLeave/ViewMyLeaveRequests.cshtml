@model List<hrms_mvc.Models.LeaveRequest>

@{
    Layout = "~/Views/Shared/_EmployeeLayout.cshtml";
    ViewData["Title"] = "My Leave Requests";

    var leaveBalances =
        ViewBag.LeaveBalances as List<hrms_mvc.Models.LeaveBalance>;

    var leaveTypes =
        ViewBag.LeaveTypes as List<hrms_mvc.Models.MasterLeaveType>;

    leaveBalances ??=
        new List<hrms_mvc.Models.LeaveBalance>();

    leaveTypes ??=
        new List<hrms_mvc.Models.MasterLeaveType>();
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<link rel="stylesheet"
      href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />


<div class="container-fluid bg-light min-vh-100 py-4">

    <div class="container-fluid">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>
                <h2 class="fw-bold text-primary mb-1">
                    Employee Leave
                </h2>

                <p class="text-muted mb-0">
                    Employee / Leave Requests
                </p>
            </div>

            <button type="button"
                    class="btn btn-warning"
                    data-bs-toggle="modal"
                    data-bs-target="#applyLeaveModal">

                <i class="bi bi-plus-circle me-1"></i>
                Apply Leave

            </button>

        </div>


        @if (TempData["success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm"
                 role="alert">

                <i class="bi bi-check-circle-fill me-2"></i>

                @TempData["success"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }


        <div class="row g-4 mb-4">

            @foreach (var balance in leaveBalances)
            {
                var usedDays =
                    Model?
                        .Where(x =>
                            x.LeaveTypeId ==
                            balance.DepartmentLeaves.LeaveTypeId &&
                            (x.Status == "Approved" ||
                             x.Status == "Pending"))
                        .Sum(x => x.NumberOfDays) ?? 0;

                var remaining =
                    balance.DepartmentLeaves.LeavesCount -
                    usedDays;

                if (remaining < 0)
                {
                    remaining = 0;
                }

                <div class="col-xl-3 col-md-6">

                    <div class="card border-0 shadow-sm h-100">

                        <div class="card-body">

                            <div class="bg-primary text-white rounded-3
                                        p-2 d-inline-flex mb-3">

                                <i class="bi bi-calendar-check fs-5"></i>

                            </div>

                            <h4 class="fw-bold text-primary mb-1">

                                @balance.DepartmentLeaves.MasterLeaveType.Leave

                            </h4>

                            <p class="text-muted mb-3">
                                Total Leaves :
                                @balance.DepartmentLeaves.LeavesCount
                            </p>

                            <hr />

                            <div class="d-flex justify-content-between">

                                <span class="text-success fw-semibold">
                                    Remaining
                                </span>

                                <span class="fw-bold text-success">
                                    @remaining
                                </span>

                            </div>

                            <div class="d-flex justify-content-between mt-2">

                                <span class="text-muted">
                                    Used
                                </span>

                                <span class="fw-semibold">
                                    @usedDays
                                </span>

                            </div>

                        </div>

                    </div>

                </div>
            }

            @if (!leaveBalances.Any())
            {
                <div class="col-12">

                    <div class="alert alert-info mb-0">

                        <i class="bi bi-info-circle me-2"></i>

                        No leave balance has been assigned to you.

                    </div>

                </div>
            }

        </div>


        <div class="card border-0 shadow-sm">

            <div class="card-header bg-white border-0 py-3">

                <div class="row align-items-end g-3">

                    <div class="col-lg-4">

                        <h5 class="fw-bold text-primary mb-0">
                            My Leave Requests
                        </h5>

                    </div>

                    <div class="col-lg-3">

                        <label class="form-label fw-semibold">
                            Status
                        </label>

                        <select id="statusFilter"
                                class="form-select">

                            <option value="">
                                All Status
                            </option>

                            <option value="Pending">
                                Pending
                            </option>

                            <option value="Approved">
                                Approved
                            </option>

                            <option value="Rejected">
                                Rejected
                            </option>

                        </select>

                    </div>

                </div>

            </div>


            <div class="card-body">

                <div class="table-responsive">

                    <table id="leaveTable"
                           class="table table-bordered
                                  table-hover align-middle w-100">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Leave ID
                                </th>

                                <th>
                                    Leave Type
                                </th>

                                <th>
                                    Start Date
                                </th>

                                <th>
                                    End Date
                                </th>

                                <th>
                                    Days
                                </th>

                                <th>
                                    Reason
                                </th>

                                <th>
                                    Approved By
                                </th>

                                <th>
                                    Status
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @if (Model != null &&
                                 Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <tr>

                                        <td>
                                            @item.Id
                                        </td>

                                        <td>
                                            @item.MasterLeaveType?.Leave
                                        </td>

                                        <td>
                                            @item.StartDate.ToString(
                                                "yyyy-MM-dd")
                                        </td>

                                        <td>
                                            @item.EndDate.ToString(
                                                "yyyy-MM-dd")
                                        </td>

                                        <td>
                                            @item.NumberOfDays
                                        </td>

                                        <td>
                                            @(string.IsNullOrWhiteSpace(
                                                item.Reason)
                                                ? "-"
                                                : item.Reason)
                                        </td>

                                        <td>
                                            @(string.IsNullOrWhiteSpace(
                                                item.ApprovedBy)
                                                ? "-"
                                                : item.ApprovedBy)
                                        </td>

                                        <td>

                                            @if (item.Status == "Approved")
                                            {
                                                <span class="badge bg-success">
                                                    <i class="bi bi-check-circle me-1"></i>
                                                    Approved
                                                </span>
                                            }
                                            else if (item.Status == "Rejected")
                                            {
                                                <span class="badge bg-danger">
                                                    <i class="bi bi-x-circle me-1"></i>
                                                    Rejected
                                                </span>
                                            }
                                            else if (item.Status == "Pending")
                                            {
                                                <span class="badge bg-warning text-dark">
                                                    <i class="bi bi-clock me-1"></i>
                                                    Pending
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">
                                                    @item.Status
                                                </span>
                                            }

                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>

                                    <td colspan="8"
                                        class="text-center text-muted py-4">

                                        <i class="bi bi-calendar-x fs-3 d-block mb-2"></i>

                                        No leave requests found.

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>


<div class="modal fade"
     id="applyLeaveModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <form asp-controller="Leave"
                  asp-action="ApplyLeave"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-header">

                    <h5 class="modal-title fw-bold text-primary">

                        <i class="bi bi-calendar-plus me-2"></i>
                        Apply Leave

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Leave Type
                            </label>

                          <select name="LeaveTypeId"
        class="form-select"
        required>

    <option value="">
        Select Leave Type
    </option>

    @foreach (var leaveType in leaveTypes)
    {
        <option value="@leaveType.Id">
            @leaveType.Leave
        </option>
    }

</select>

                        </div>


                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Number of Days
                            </label>

                            <input type="text"
                                   id="numberOfDays"
                                   class="form-control"
                                   readonly />

                        </div>


                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                Start Date
                            </label>

                            <input type="date"
                                   name="StartDate"
                                   id="startDate"
                                   class="form-control"
                                   required />

                        </div>


                        <div class="col-md-6">

                            <label class="form-label fw-semibold">
                                End Date
                            </label>

                            <input type="date"
                                   name="EndDate"
                                   id="endDate"
                                   class="form-control"
                                   required />

                        </div>


                        <div class="col-12">

                            <label class="form-label fw-semibold">
                                Reason
                            </label>

                            <textarea name="Reason"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Enter reason for leave"
                                      required></textarea>

                        </div>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-warning">

                        <i class="bi bi-send me-1"></i>
                        Apply Leave

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts
{
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>

    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>


    <script>

        $(document).ready(function () {

            var table =
                $("#leaveTable").DataTable({

                    pageLength: 10,

                    lengthMenu: [
                        [5, 10, 25, 50],
                        [5, 10, 25, 50]
                    ],

                    ordering: true,

                    searching: true,

                    responsive: true,

                    order: [
                        [0, "desc"]
                    ],

                    language: {

                        search: "Search:",

                        lengthMenu:
                            "Show _MENU_ entries",

                        info:
                            "Showing _START_ to _END_ of _TOTAL_ entries",

                        emptyTable:
                            "No leave requests found."

                    }

                });


            $("#statusFilter").on(
                "change",
                function () {

                    table
                        .column(7)
                        .search(this.value)
                        .draw();

                }
            );


            function calculateDays() {

                var start =
                    $("#startDate").val();

                var end =
                    $("#endDate").val();

                if (!start || !end) {

                    $("#numberOfDays").val("");

                    return;

                }

                var startDate =
                    new Date(start);

                var endDate =
                    new Date(end);

                if (endDate < startDate) {

                    $("#numberOfDays").val("");

                    return;

                }

                var difference =
                    endDate.getTime() -
                    startDate.getTime();

                var days =
                    Math.floor(
                        difference /
                        (1000 * 60 * 60 * 24)
                    ) + 1;

                $("#numberOfDays").val(days);

            }


            $("#startDate, #endDate").on(
                "change",
                calculateDays
            );

        });

    </script>
}