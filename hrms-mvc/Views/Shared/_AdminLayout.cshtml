<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - HRMS Admin</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css" />
    <link rel="stylesheet"
          href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />

    <link rel="stylesheet"
          href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    @RenderSection("Styles", required: false)
</head>

<body>

    <div class="admin-layout">

        <aside class="admin-sidebar">

            <div class="sidebar-logo">
                <h2>Team2</h2>
            </div>

            <p class="sidebar-title">MAIN MENU</p>

            <nav class="sidebar-menu">

                <!-- Dashboard -->
                <a asp-controller="Auth"
                   asp-action="Admin"
                   class="sidebar-link active">
                    <span>⌂</span>
                    Dashboard
                    <span class="hot-badge">Hot</span>
                </a>

                <!-- Employees -->
                <details open>
                    <summary class="sidebar-link">
                        <span>♙</span>
                        Employees
                        <span class="menu-arrow">⌃</span>
                    </summary>

                    <div class="submenu">

                        <a asp-controller="Department"
                           asp-action="Index">
                            Add Department
                        </a>

                        <a asp-controller="Role"
                           asp-action="Index">
                            Add Role
                        </a>

                        <a asp-controller="Designation"
                           asp-action="Index">
                            Add Designation
                        </a>

                        <a asp-controller="EmployeeList"
                           asp-action="Index">
                            Employee List
                        </a>

                        <a asp-controller="EmployeeList"
                           asp-action="Grid">
                            Employee Grid
                        </a>

                        <a asp-controller="EmployeeDetails"
                           asp-action="Index">
                            Employee Details
                        </a>

                    </div>
                </details>

                <!-- Events -->
                <details>
                    <summary class="sidebar-link">
                        <span>♧</span>
                        Events
                        <span class="menu-arrow">⌄</span>
                    </summary>

                    <div class="submenu">
                        <a href="#">Event List</a>
                        <a href="#">Add Event</a>
                    </div>
                </details>

                <!-- Training -->
                <details>
                    <summary class="sidebar-link">
                        <span>✎</span>
                        Training
                        <span class="menu-arrow">⌄</span>
                    </summary>

                    <div class="submenu">
                        <a href="#">Training List</a>
                        <a href="#">Add Training</a>
                    </div>
                </details>

                <!-- Performance and Goal -->
                <details>
                    <summary class="sidebar-link">
                        <span>▱</span>
                        Performance &amp; Goal
                        <span class="menu-arrow">⌄</span>
                    </summary>

                    <div class="submenu">
                        <a href="#">Performance List</a>
                        <a href="#">Add Goal</a>
                    </div>
                </details>

                <!-- Reports -->
                <details>
                    <summary class="sidebar-link">
                        <span>▱</span>
                        Reports
                        <span class="menu-arrow">⌄</span>
                    </summary>

                    <div class="submenu">

                        <a asp-controller="Reports"
                           asp-action="Index">
                            Employee Report
                        </a>

                        <a asp-controller="Reports"
                           asp-action="Attendance">
                            Attendance Report
                        </a>

                        <a asp-controller="Reports"
                           asp-action="LeaveReport">
                            Leave Report
                        </a>

                    </div>
                </details>

                <!-- Master Documents -->
                <details>
                    <summary class="sidebar-link">
                        <span>▱</span>
                        Master Documents
                        <span class="menu-arrow">⌄</span>
                    </summary>

                    <div class="submenu">
                        <a href="#">Document Categories</a>
                        <a href="#">Document Types</a>
                    </div>
                </details>

                <!-- Documents -->
                <details>
                    <summary class="sidebar-link">
                        <span>▱</span>
                        Documents
                        <span class="menu-arrow">⌄</span>
                    </summary>

                    <div class="submenu">
                        <a href="#">All Documents</a>
                        <a href="#">Upload Document</a>
                    </div>
                </details>

                <!-- Logout -->
                <a asp-controller="Auth"
                   asp-action="Logout"
                   class="sidebar-link logout-link">
                    <span>⇥</span>
                    Logout
                </a>

            </nav>

        </aside>

        <div class="admin-content">

            <header class="admin-header">
                <h2>HRMS - Admin Panel</h2>
            </header>

            <main>
                @RenderBody()
            </main>

            <footer>
                <p>Admin Layout</p>
            </footer>
            <script src="~/lib/jquery/dist/jquery.min.js"></script>
            <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

            @await RenderSectionAsync("Scripts", required: false)
        </div>

    </div>


</body>
</html>
