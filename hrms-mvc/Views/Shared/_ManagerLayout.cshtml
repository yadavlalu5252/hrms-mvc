<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - HRMS Manager
    </title>


    <!-- Bootstrap -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />


    <!-- Bootstrap Icons -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <!-- Site CSS -->

    <link rel="stylesheet"
          href="~/css/site.css" />

</head>


<body>

    <div class="manager-layout">


        <!-- ================= SIDEBAR ================= -->

        <aside class="manager-sidebar">

            <h2>HRMS</h2>

            <nav>

                <a asp-controller="Manager"
                   asp-action="Index">

                    <i class="bi bi-speedometer2"></i>

                    <span>
                        Dashboard
                    </span>

                </a>


                <a asp-controller="Manager"
                   asp-action="Team">

                    <i class="bi bi-people"></i>

                    <span>
                        My Team
                    </span>

                </a>


                <a asp-controller="Manager"
                   asp-action="LeaveRequests">

                    <i class="bi bi-calendar-x"></i>

                    <span>
                        Leave Requests
                    </span>

                </a>

                                <!-- Promotion -->
                <a asp-controller="Promotion"
                   asp-action="Index"
                   class="sidebar-link">
                    <span>⌂</span>
                    Promotion
                </a>
                <!-- Resignation -->
                <a asp-controller="Resignation"
                   asp-action="Index"
                   class="sidebar-link">
                    <span>⌂</span>
                    Resignation
                </a>
                <!-- Termination -->
                <a asp-controller="Termination"
                   asp-action="Index"
                   class="sidebar-link">
                    <span>⌂</span>
                    Termination
                </a>
                <!-- Tickets -->
                <a asp-controller="Ticket"
                   asp-action="Index"
                   class="sidebar-link">
                    <span>⌂</span>
                    Ticket
                </a>
                <a asp-controller="Auth"
                   asp-action="Logout">

                    <i class="bi bi-box-arrow-right"></i>

                    <span>
                        Logout
                    </span>

                </a>

            </nav>

        </aside>


        <!-- ================= MAIN CONTENT ================= -->

        <div class="manager-content">


            <!-- ================= HEADER ================= -->

            <header class="manager-header">


                <!-- Left -->

                <div class="manager-header-left">


                    <!-- Search -->

                    <div class="manager-search">

                        <i class="bi bi-search"></i>

                        <input type="text";
                               id="managerSearch"
                               placeholder="Search in HRMS" />

                    </div>

                </div>


                <!-- Right -->

                <div class="manager-header-right">


                    <!-- Profile -->

                    <div class="manager-profile-dropdown">


                        <button type="button"
                                class="manager-profile-button"
                                id="managerProfileButton">

                            <div class="manager-profile-icon">

                                <i class="bi bi-person"></i>

                            </div>

                        </button>


                        <!-- Profile Menu -->

                        <div class="manager-profile-menu"
                             id="managerProfileMenu">


                            <!-- User Information -->

                            <div class="manager-profile-header">

                                <div class="manager-profile-menu-icon">

                                    <i class="bi bi-person"></i>

                                </div>


                                <div>

                                    <strong>
                                        @Context.Session.GetString("Email")
                                    </strong>

                                    <small>
                                        Manager
                                    </small>

                                </div>

                            </div>


                            <div class="manager-profile-divider"></div>


                            <!-- My Profile -->

                            <a asp-controller="Manager"
                               asp-action="Index"
                               class="manager-profile-item">

                                <i class="bi bi-person"></i>

                                <span>
                                    My Profile
                                </span>

                            </a>


                            <!-- Logout -->

                            <a asp-controller="Auth"
                               asp-action="Logout"
                               class="manager-profile-item manager-logout">

                                <i class="bi bi-power"></i>

                                <span>
                                    Logout
                                </span>

                            </a>


                        </div>

                    </div>

                </div>

            </header>


            <!-- ================= PAGE CONTENT ================= -->

            <main>

                @RenderBody()

            </main>


            <!-- ================= FOOTER ================= -->

            <footer class="manager-footer">

                <p>
                    © 2026 HRMS - Manager Panel
                </p>

            </footer>


        </div>

    </div>


    <!-- Bootstrap JS -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>


    <!-- Profile Dropdown -->

    <script>

        const managerProfileButton =
            document.getElementById("managerProfileButton");

        const managerProfileMenu =
            document.getElementById("managerProfileMenu");


        managerProfileButton.addEventListener("click", function (event) {

            event.stopPropagation();

            managerProfileMenu.classList.toggle("show");

        });


        document.addEventListener("click", function (event) {

            if (!managerProfileMenu.contains(event.target) &&
                !managerProfileButton.contains(event.target)) {

                managerProfileMenu.classList.remove("show");

            }

        });

    </script>


    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>