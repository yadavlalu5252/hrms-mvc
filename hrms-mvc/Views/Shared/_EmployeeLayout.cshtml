<!DOCTYPE html>
<html>
<head>
    <title>Employee - HRMS</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

    <header>
        <h2>HRMS - Employee Panel</h2>
    </header>

    <nav>
        <a asp-controller="Employee" asp-action="Dashboard">Dashboard</a>
        <a asp-controller="Employee" asp-action="Profile">My Profile</a>
        <a asp-controller="Employee" asp-action="Attendance">Attendance</a>
        <a asp-controller="Employee" asp-action="Leave">Leave</a>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer>
        <p>Employee Layout</p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>