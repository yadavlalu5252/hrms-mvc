<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - HRMS Employee
    </title>


    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />


    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <!-- Site CSS -->
    <link rel="stylesheet"
          href="~/css/site.css" />

</head>


<body>

    <div class="employee-layout">


        <!-- ================= SIDEBAR ================= -->

        <aside class="employee-sidebar">

            <h2>HRMS</h2>

            <nav>

                <a asp-controller="Employee"
                   asp-action="Index">

                    <i class="bi bi-speedometer2"></i>

                    <span>
                        Dashboard
                    </span>

                </a>



                <!-- Attendance-->
                <details>
                    <summary class="sidebar-link">
                        <i class="bi bi-calendar-check"></i>
                        Attendance
                        <span class="menu-arrow">⌄</span>
                    </summary>

                    <div class="submenu">
                        <a asp-controller="EmployeeAttendance" asp-action="Index">Attendance</a>
                       

                    </div>
                </details>

                <!-- Leave-->
                <details>
                    <summary class="sidebar-link">
                        <span>♧</span>
                        Leave
                        <span class="menu-arrow">⌄</span>
                    </summary>

                    <div class="submenu">
                        <a asp-controller="EmployeeLeave" asp-action="ViewMyLeaveRequests">Leave</a>
                    </div>
                </details>

         
           


               

                <a asp-controller="Employee"
                   asp-action="Leave">

                    <i class="bi bi-calendar-x"></i>

                    <span>
                        Leave
                    </span>

                </a>
                <a asp-controller="Document"
                   asp-action="Index">

                    <i class="bi bi-file-earmark-text"></i>

                    <span>
                        Document
                    </span>

                </a>
                <a asp-controller="Ticket"
                   asp-action="Index">

                    <i class="bi bi-ticket-perforated"></i>

                    <span>
                        Tickets
                    </span>

                </a>


                <a asp-controller="Auth"
                   asp-action="Logout">

                    <i class="bi bi-box-arrow-right"></i>

                    <span>
                        Logout
                    </span>

                </a>

            </nav>

        </aside>


        <!-- ================= MAIN CONTENT ================= -->

        <div class="employee-content">


            <!-- ================= HEADER ================= -->

            <header class="employee-header">


                <!-- Left Side -->

                <div class="employee-header-left">




                    <!-- Search -->

                    <div class="employee-search">

                        <i class="bi bi-search"></i>

                        <input type="text"
                               id="employeeSearch"
                               placeholder="Search in Pulse360" />

                       

                    </div>

                </div>


                <!-- Right Side -->

                <div class="employee-header-right">


                    <!-- Profile -->

                    <div class="employee-profile-dropdown">


                        <button type="button"
                                class="employee-profile-button"
                                id="employeeProfileButton">


                            <div class="employee-profile-icon">

                                <i class="bi bi-person"></i>

                            </div>


                        </button>


                        <!-- Profile Menu -->

                        <div class="employee-profile-menu"
                             id="employeeProfileMenu">


                            <!-- User Information -->

                            <div class="employee-profile-header">


                                <div class="employee-profile-menu-icon">

                                    <i class="bi bi-person"></i>

                                </div>


                                <div>

                                    <strong>
                                        @Context.Session.GetString("Email")
                                    </strong>

                                    <small>
                                        Employee
                                    </small>

                                </div>

                            </div>


                            <div class="employee-profile-divider"></div>


                            <!-- My Profile -->

                            <a asp-controller="Employee"
                               asp-action="Index"
                               class="employee-profile-item">

                                <i class="bi bi-person"></i>

                                <span>
                                    My Profile
                                </span>

                            </a>


                            <!-- Logout -->

                            <a asp-controller="Auth"
                               asp-action="Logout"
                               class="employee-profile-item employee-logout">

                                <i class="bi bi-power"></i>

                                <span>
                                    Logout
                                </span>

                            </a>


                        </div>

                    </div>

                </div>

            </header>


            <!-- ================= PAGE CONTENT ================= -->

            <main>

                @RenderBody()

            </main>


            <!-- ================= FOOTER ================= -->

            <footer class="employee-footer">

                <p>
                    © 2026 HRMS - Employee Panel
                </p>

            </footer>


        </div>

    </div>


    <!-- Bootstrap JS -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>


    <!-- Profile Dropdown -->

    <script>

        const employeeProfileButton =
            document.getElementById("employeeProfileButton");

        const employeeProfileMenu =
            document.getElementById("employeeProfileMenu");


        employeeProfileButton.addEventListener("click", function (event) {

            event.stopPropagation();

            employeeProfileMenu.classList.toggle("show");

        });


        document.addEventListener("click", function (event) {

            if (!employeeProfileMenu.contains(event.target) &&
                !employeeProfileButton.contains(event.target)) {

                employeeProfileMenu.classList.remove("show");

            }

        });

    </script>


    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>