<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />


    <title>@ViewData["Title"] - HRMS Employee</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body>

    <div class="employee-layout">

        <aside class="employee-sidebar">

            <h2>HRMS</h2>

            <nav>

                <a asp-controller="Employee" asp-action="Index">
                    <i class="bi bi-speedometer2"></i>
                    Dashboard
                </a>

                <a asp-controller="Employee" asp-action="Profile">
                    <i class="bi bi-person"></i>
                    My Profile
                </a>
                <!-- Attendance-->
                <details>
                    <summary class="sidebar-link">
                        <span>♧</span>
                        Attendance
                        <span class="menu-arrow">⌄</span>
                    </summary>

                    <div class="submenu">
                        <a asp-controller="EmployeeAttendance" asp-action="Index">Attendance</a>
                       

                    </div>
                </details>



         
           

                <a asp-controller="Employee" asp-action="Attendance">
                    <i class="bi bi-calendar-check"></i>
                    Attendance
                </a>

                <a asp-controller="Employee" asp-action="Leave">
                    <i class="bi bi-calendar-x"></i>
                    Leave
                </a>


                <a asp-controller="Auth" asp-action="Logout">
                    <i class="bi bi-box-arrow-right"></i>
                    Logout
                </a>

            </nav>

        </aside>

        <div class="employee-content">

            <header class="employee-header">
                <h2>HRMS - Employee Panel</h2>
            </header>

            <main>
                @RenderBody()
            </main>

            <footer class="employee-footer">
                <p>© 2026 HRMS - Employee Panel</p>
            </footer>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>