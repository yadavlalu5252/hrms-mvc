@using hrms_mvc.Models

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Employee Details";

    var employee = ViewBag.Employee as User;
    var bankDetails = ViewBag.BankDetails as EmployeeBankDetails;
    var familyDetails = ViewBag.FamilyDetails as List<EmployeeFamilyDetail>;
    var educationDetails = ViewBag.EducationDetails as List<EducationDetails>;
    var experienceDetails = ViewBag.ExperienceDetails as List<Experience>;
}

<div class="row">

    <!-- Left Side: Employee Profile -->
    <div class="col-md-5 mb-4">

        <div class="card shadow-sm border-0">

            <!-- Orange Profile Header -->
            <div class="position-relative"
                 style="height: 150px; background: linear-gradient(135deg, #ff6a00, #ffb300);">

                <!-- Circular Profile Image -->
                <img src="@employee?.ProfilePicture"
                     alt="Profile Picture"
                     class="rounded-circle position-absolute top-100 start-50 translate-middle border border-3 border-white"
                     style="width: 85px; height: 85px; object-fit: cover;" />

            </div>

            <!-- Employee Details -->
            <div class="card-body text-center pt-5">

                <h5 class="mb-1">
                    @employee?.FirstName @employee?.LastName
                </h5>

                <span class="badge bg-secondary mb-3">
                    @employee?.Designation?.DesignationName
                </span>

                <div class="text-start">

                    <p class="mb-2">
                        <strong>Client ID:</strong>
                        <span class="float-end">
                            @employee?.Id
                        </span>
                    </p>

                    <p class="mb-2">
                        <strong>Department:</strong>
                        <span class="float-end">
                            @employee?.Department?.Name
                        </span>
                    </p>

                    <p class="mb-2">
                        <strong>Date of Join:</strong>
                        <span class="float-end">
                            @employee?.DateOfJoining.ToString("dd-MM-yyyy")
                        </span>
                    </p>

                    <p class="mb-3">
                        <strong>Report Office:</strong>
                        <span class="float-end">
                            @employee?.Address
                        </span>
                    </p>

                </div>

                <button class="btn btn-dark w-100 mb-3"
                        data-bs-toggle="modal"
                        data-bs-target="#editEmployeeModal">

                    <i class="bi bi-pencil-square"></i>
                    Edit Info

                </button>

                <hr />

                <h6 class="text-start text-primary mb-3">
                    Basic Information
                </h6>

                <div class="text-start">

                    <p class="mb-2">
                        <strong>Phone:</strong>
                        <span class="float-end">
                            @employee?.MobileNumber
                        </span>
                    </p>

                    <p class="mb-2">
                        <strong>Email:</strong>
                        <span class="float-end">
                            @employee?.Email
                        </span>
                    </p>

                    <p class="mb-2">
                        <strong>Gender:</strong>
                        <span class="float-end">
                            @employee?.Gender
                        </span>
                    </p>

                    <p class="mb-2">
                        <strong>Birthday:</strong>
                        <span class="float-end">
                            @employee?.DateOfBirth.ToString("dd-MM-yyyy")
                        </span>
                    </p>

                    <p class="mb-0">
                        <strong>Address:</strong>
                        <span class="float-end">
                            @employee?.Address
                        </span>
                    </p>

                </div>

            </div>

        </div>

    </div>

    <!-- Right Side: Other Information -->
    <div class="col-md-7">

        <!-- About Employee -->
        <div class="card mb-4">

            <div class="card-header d-flex justify-content-between align-items-center">

                <h5 class="mb-0">
                    About Employee
                </h5>

                <button class="btn btn-sm btn-light"
                        data-bs-toggle="modal"
                        data-bs-target="#editEmployeeModal">

                    ✎

                </button>

            </div>

            <div class="card-body">

                <p>
                    @employee?.AboutEmployee
                </p>

            </div>

        </div>

        <!-- Bank Information -->
        <div class="card mb-4">

            <div class="card-header d-flex justify-content-between align-items-center">

                <h5 class="mb-0">
                    Bank Information
                </h5>

                <div>

                    @if (bankDetails != null)
                    {
                        <button class="btn btn-sm btn-light"
                                data-bs-toggle="modal"
                                data-bs-target="#editBankDetailsModal">

                            ✎

                        </button>
                    }

                    <button class="btn btn-sm btn-light"
                            data-bs-toggle="modal"
                            data-bs-target="#addBankDetailsModal">

                        +

                    </button>

                </div>

            </div>

            <div class="card-body">

                @if (bankDetails != null)
                {
                    <div class="row">

                        <div class="col-md-6">

                            <p>
                                <strong>Bank Name:</strong>
                                @bankDetails.BankName
                            </p>

                            <p>
                                <strong>Account Number:</strong>
                                @bankDetails.AccountNumber
                            </p>

                        </div>

                        <div class="col-md-6">

                            <p>
                                <strong>IFSC Code:</strong>
                                @bankDetails.IFSCCode
                            </p>

                            <p>
                                <strong>Branch Name:</strong>
                                @bankDetails.BranchName
                            </p>

                        </div>

                    </div>
                }
                else
                {
                    <p>
                        No bank details available.
                    </p>
                }

            </div>

        </div>

        <!-- Family Information -->
        <div class="card mb-4">

            <div class="card-header d-flex justify-content-between align-items-center">

                <h5 class="mb-0">
                    Family Information
                </h5>

                <div>

                    <button class="btn btn-sm btn-light"
                            data-bs-toggle="modal"
                            data-bs-target="#addFamilyDetailsModal">

                        +

                    </button>

                    @if (familyDetails != null && familyDetails.Any())
                    {
                        <button class="btn btn-sm btn-light"
                                data-bs-toggle="modal"
                                data-bs-target="#editFamilyDetailsModal">

                            ✎

                        </button>
                    }

                </div>

            </div>

            <div class="card-body">

                <div class="row">

                    @if (familyDetails != null && familyDetails.Any())
                    {
                        foreach (var family in familyDetails)
                        {
                            <div class="col-md-4">

                                <small>Family Id</small>
                                <p>
                                    @family.Id
                                </p>

                                <small>Phone</small>
                                <p>
                                    @family.MobileNumber
                                </p>

                            </div>

                            <div class="col-md-4">

                                <small>Name</small>
                                <p>
                                    @family.Name
                                </p>

                                <small>Date of Birth</small>
                                <p>
                                    @family.DateOfBirth.ToString("dd-MM-yyyy")
                                </p>

                            </div>

                            <div class="col-md-4">

                                <small>Relationship</small>
                                <p>
                                    @family.Relation
                                </p>

                                <small>User Id</small>
                                <p>
                                    @family.UserId
                                </p>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12">

                            <p>
                                No family details available.
                            </p>

                        </div>
                    }

                </div>

            </div>

        </div>

        <!-- Education and Experience -->
        <div class="row">

            <!-- Education Details -->
<div class="col-md-6">

    <div class="card mb-4">

        <div class="card-header d-flex justify-content-between align-items-center">

            <h5 class="mb-0">
                Education Details
            </h5>

            <div>

                <button type="button"
                        class="btn btn-sm btn-light"
                        data-bs-toggle="modal"
                        data-bs-target="#addEducationModal">

                    +

                </button>

                @if (educationDetails != null && educationDetails.Any())
                {
                    <button type="button"
                            class="btn btn-sm btn-light"
                            data-bs-toggle="modal"
                            data-bs-target="#editEducationModal-@educationDetails.First().EducationDetailsId">

                        ✎

                    </button>
                }

            </div>

        </div>

        <div class="card-body">

            @if (educationDetails != null && educationDetails.Any())
            {
                foreach (var education in educationDetails)
                {
                    <p>
                        <strong>Education:</strong>
                        @education.EducationType
                    </p>

                    <p>
                        <strong>University:</strong>
                        @education.UniversityName
                    </p>

                    <p>
                        <strong>Start Date:</strong>
                        @(education.startdate.HasValue
                            ? education.startdate.Value.ToString("dd-MM-yyyy")
                            : "")
                    </p>

                    <p>
                        <strong>End Date:</strong>
                        @(education.enddate.HasValue
                            ? education.enddate.Value.ToString("dd-MM-yyyy")
                            : "")

                    </p>

                    <hr />

                    @await Html.PartialAsync(
                        "Modals/_EditEducationDetailsModal",
                        education
                    )
                }
            }
            else
            {
                <p>
                    No education details available.
                </p>
            }

            @await Html.PartialAsync(
                "Modals/_AddEducationDetailsModal",
                new hrms_mvc.Models.EducationDetails()
            )

        </div>

    </div>

</div>

            <!-- Experience -->
            <div class="col-md-6">

                <div class="card mb-4">

                    <div class="card-header d-flex justify-content-between align-items-center">

                        <h5 class="mb-0">
                            Experience
                        </h5>

                        <div>

                            <button class="btn btn-sm btn-light"
                                    data-bs-toggle="modal"
                                    data-bs-target="#addExperienceModal">

                                +

                            </button>

                            @if (experienceDetails != null && experienceDetails.Any())
                            {
                                var firstExperience = experienceDetails.First();

                                <button class="btn btn-sm btn-light"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editExperienceModal-@firstExperience.ExperienceId">

                                    ✎

                                </button>
                            }

                        </div>

                    </div>

                    <div class="card-body">

                        @if (experienceDetails != null && experienceDetails.Any())
                        {
                            foreach (var experience in experienceDetails)
                            {
                                <p>
                                    <strong>Company:</strong>
                                    @experience.CompanyName
                                </p>

                                <p>
                                    <strong>Designation:</strong>
                                    @experience.DesignationName
                                </p>

                                <p>
                                    <strong>Start Date:</strong>
                                    @experience.FromDate.ToString("dd-MM-yyyy")
                                </p>

                                <p>
                                    <strong>End Date:</strong>
                                    @experience.ToDate.ToString("dd-MM-yyyy")
                                </p>

                                @await Html.PartialAsync(
                                    "Modals/_EditExperienceDetailsModal",
                                    experience
                                )

                                <hr />
                            }
                        }
                        else
                        {
                            <p>
                                No experience details available.
                            </p>
                        }

                    </div>

                </div>

            </div>

            @await Html.PartialAsync(
                "Modals/_AddExperienceDetailsModal",
                new hrms_mvc.Models.Experience()
            )
        </div>

    </div>

</div>

<!-- Employee Edit Modal -->
@await Html.PartialAsync(
    "Modals/_EditEmployeeModal",
    employee
)

<!-- Bank Modals -->
@await Html.PartialAsync(
    "Modals/_AddBankDetailsModal",
    new EmployeeBankDetails()
)

@await Html.PartialAsync(
    "Modals/_EditBankDetailsModal",
    bankDetails
)

<!-- Family Modals -->
@await Html.PartialAsync(
    "Modals/_AddFamilyDetailsModal",
    new EmployeeFamilyDetail()
)

@foreach (var familyDetail in familyDetails)
{
    @await Html.PartialAsync(
        "Modals/_EditFamilyDetailsModal",
        familyDetail
    )
}

<!-- Education Modals -->
@await Html.PartialAsync(
    "Modals/_AddEducationDetailsModal",
    new EducationDetails()
)

@foreach (var education in educationDetails)
{
    @await Html.PartialAsync(
        "Modals/_EditEducationDetailsModal",
        education
    )
}

<!-- Experience Modals -->
@await Html.PartialAsync(
    "Modals/_AddExperienceDetailsModal",
    new Experience()
)

@foreach (var experience in experienceDetails)
{
    @await Html.PartialAsync(
        "Modals/_EditExperienceDetailsModal",
        experience
    )
}