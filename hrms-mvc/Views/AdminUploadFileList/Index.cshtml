@model IEnumerable<hrms_mvc.Models.Documents>

@{
    ViewData["Title"] = "Uploaded Documents";
}

<h2>Uploaded Documents</h2>

<div class="mb-3">
    <a asp-controller="AdminFilesUpload"
       asp-action="Index"
       class="btn btn-primary">
        Upload Document
    </a>
</div>

<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>Document ID</th>
            <th>Email</th>
            <th>Document Name</th>
            <th>File Name</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>

        @if (Model != null && Model.Any())
        {
            @foreach (var document in Model)
            {
                <tr>
                    <td>
                        @document.DocId
                    </td>

                    <td>
                        @document.Email
                    </td>

                    <td>
                        @document.DocName
                    </td>

                    <td>
                        @document.DocFile
                    </td>

                    <td>
                        <a asp-controller="AdminUploadFileList"
                           asp-action="ViewFile"
                           asp-route-id="@document.DocId"
                           target="_blank"
                           class="btn btn-sm btn-info">
                            View
                        </a>

                        <a asp-controller="AdminUploadFileList"
                           asp-action="Download"
                           asp-route-id="@document.DocId"
                           class="btn btn-sm btn-success">
                            Download
                        </a>

                        <form asp-controller="AdminUploadFileList"
                              asp-action="Delete"
                              asp-route-id="@document.DocId"
                              method="post"
                              style="display:inline;">

                            <button type="submit"
                                    class="btn btn-sm btn-danger"
                                    onclick="return confirm('Are you sure you want to delete this document?');">
                                Delete
                            </button>

                        </form>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5"
                    class="text-center">
                    No documents uploaded yet.
                </td>
            </tr>
        }

    </tbody>

</table>