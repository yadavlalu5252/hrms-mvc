@model hrms_mvc.Models.TrainingType

<div class="main-wrapper">

    <div class="card p-4">

        <h3 class="mb-4">Edit Training Type</h3>

        <form asp-controller="TrainingType"
              asp-action="UpdateTrainingType"
              method="post">

            <input type="hidden"
                   asp-for="TrainingTypeId" />

            <div class="mb-3">

                <label class="form-label">
                    Training Type Name
                </label>

                <input type="text"
                       class="form-control"
                       asp-for="TrainingTypeName">

                <span asp-validation-for="TrainingTypeName"
                      class="text-danger"></span>

            </div>


            <div class="mb-3">

                <label class="form-label">
                    Description
                </label>

                <textarea class="form-control"
                          asp-for="Description"
                          rows="4"></textarea>

                <span asp-validation-for="Description"
                      class="text-danger"></span>

            </div>


            <div class="mb-3">

                <label class="form-label">
                    Status
                </label>

                <select class="form-select"
                        asp-for="Status">

                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>

                </select>

                <span asp-validation-for="Status"
                      class="text-danger"></span>

            </div>


            <div class="d-flex justify-content-end">

                <a asp-controller="TrainingType"
                   asp-action="FetchAll"
                   class="btn btn-light me-2">
                    Cancel
                </a>

                <button type="submit"
                        class="btn btn-primary">
                    Update Training Type
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}