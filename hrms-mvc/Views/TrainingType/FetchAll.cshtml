@model IEnumerable<hrms_mvc.Models.TrainingType>

<div class="main-wrapper">

    <div class="card p-4">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <h3 class="mb-0">Training Type List</h3>

            <a asp-controller="TrainingType"
               asp-action="AddTrainingType"
               class="btn btn-primary">
                Add Training Type
            </a>

        </div>

        <div class="table-responsive">

            <table id="trainingTypeTable"
                   class="table table-bordered table-hover">

                <thead>

                    <tr>
                        <th>Id</th>
                        <th>Training Type Name</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var d in Model)
                    {
                        <tr>

                            <td>
                                @d.TrainingTypeId
                            </td>

                            <td>
                                @d.TrainingTypeName
                            </td>

                            <td>
                                @d.Description
                            </td>

                            <td>
                                @d.Status
                            </td>

                            <td>

                                <a asp-controller="TrainingType"
                                   asp-action="EditTrainingType"
                                   asp-route-id="@d.TrainingTypeId"
                                   class="btn btn-warning btn-sm">
                                    Edit
                                </a>

                                <form asp-controller="TrainingType"
                                      asp-action="DeleteTrainingType"
                                      asp-route-id="@d.TrainingTypeId"
                                      method="post"
                                      style="display:inline;">

                                    <button type="submit"
                                            class="btn btn-danger btn-sm">
                                        Delete
                                    </button>

                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>