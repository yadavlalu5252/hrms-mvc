@model IEnumerable<hrms_mvc.Models.MasterDocAdmin>

<div class="main-wrapper">
    <div class="card p-4">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <h3 class="mb-0">
                Admin Document Name List
            </h3>

            <a asp-controller="MasterDocAdmin"
               asp-action="AddAdminDocument"
               class="btn btn-primary">
                + Add Document
            </a>

        </div>

        <div class="table-responsive">

            <table id="adminDocumentTable"
                   class="table table-bordered table-hover">

                <thead>
                    <tr>
                        <th>Document ID</th>
                        <th>Document Name</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var d in Model)
                    {
                        <tr>

                            <td>
                                @d.AdminId
                            </td>

                            <td>
                                @d.AdminDocName
                            </td>

                            <td>

                                <a asp-controller="MasterDocAdmin"
                                   asp-action="EditAdminDocument"
                                   asp-route-id="@d.AdminId"
                                   class="btn btn-warning btn-sm">
                                    Edit
                                </a>

                                <form asp-controller="MasterDocAdmin"
                                      asp-action="DeleteAdminDocument"
                                      asp-route-id="@d.AdminId"
                                      method="post"
                                      style="display:inline;">

                                    <button type="submit"
                                            class="btn btn-danger btn-sm">
                                        Delete
                                    </button>

                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
</div>

@section Scripts {

    <script src="https://cdn.datatables.net/1.13.5/js/jquery.dataTables.min.js"></script>

    <script>

        $(document).ready(function() {

            $('#adminDocumentTable').DataTable({
                pageLength: 5
            });

        });

    </script>
}