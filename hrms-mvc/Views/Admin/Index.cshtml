@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Admin Dashboard";
}



<div class="container-fluid">
    <h2 class="mb-4">Admin Dashboard</h2>

    <div class="row">

        <div class="col-md-3 mb-3">
            <div class="card text-bg-primary">
                <div class="card-body">
                    <h5>Total Employees</h5>
                    <h3>@ViewBag.TotalEmployees</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card text-bg-success">
                <div class="card-body">
                    <h5>Present Employees</h5>
                    <h3>@ViewBag.PresentEmployees</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card text-bg-warning">
                <div class="card-body">
                    <h5>Half Day Employees</h5>
                    <h3>@ViewBag.HalfDayEmployees</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card text-bg-danger">
                <div class="card-body">
                    <h5>Absent Employees</h5>
                    <h3>@ViewBag.AbsentEmployees</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card text-bg-info">
                <div class="card-body">
                    <h5>Total Projects</h5>
                    <h3>@ViewBag.TotalProjects</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card text-bg-secondary">
                <div class="card-body">
                    <h5>Total Clients</h5>
                    <h3>@ViewBag.TotalClients</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card text-bg-dark">
                <div class="card-body">
                    <h5>Total Tasks</h5>
                    <h3>@ViewBag.TotalTasks</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card text-bg-success">
                <div class="card-body">
                    <h5>Total Earnings</h5>
                    <h3>@ViewBag.TotalEarnings</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card text-bg-primary">
                <div class="card-body">
                    <h5>New Hires</h5>
                    <h3>@ViewBag.NewHires</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card text-bg-info">
                <div class="card-body">
                    <h5>Production Hours</h5>
                    <h3>@ViewBag.ProductionHours</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card text-bg-warning">
                <div class="card-body">
                    <h5>Working Hours</h5>
                    <h3>@ViewBag.WorkingHours</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card text-bg-secondary">
                <div class="card-body">
                    <h5>Break Hours</h5>
                    <h3>@ViewBag.BreakHours</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card text-bg-success">
                <div class="card-body">
                    <h5>Completed Tasks</h5>
                    <h3>@ViewBag.CompletedTasks</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card text-bg-warning">
                <div class="card-body">
                    <h5>On Hold Tasks</h5>
                    <h3>@ViewBag.OnHoldTasks</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card text-bg-info">
                <div class="card-body">
                    <h5>In Progress Tasks</h5>
                    <h3>@ViewBag.InProgressTasks</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card text-bg-danger">
                <div class="card-body">
                    <h5>Pending Tasks</h5>
                    <h3>@ViewBag.PendingTasks</h3>
                </div>
            </div>
        </div>

    </div>
</div>