@model List<hrms_mvc.Models.Promotion>

@{
    var role = Context.Session.GetString("Role");

    if (role == "Admin")
    {
        Layout = "~/Views/Shared/_AdminLayout.cshtml";
    }
    else if (role == "Employee")
    {
        Layout = "~/Views/Shared/_EmployeeLayout.cshtml";
    }
    else if (role == "Manager")
    {
        Layout = "~/Views/Shared/_ManagerLayout.cshtml";
    }
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Promotion</h2>

        <button type="button"
                class="btn"
                style="background-color: #F26522; color: white;"
                data-bs-toggle="modal"
                data-bs-target="#addPromotionModal">
            Add Promotion
        </button>
    </div>

    <div class="card">

        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">

            <h5 class="mb-0">Promotion List</h5>

            <div class="d-flex align-items-center gap-2 flex-wrap">

                <select id="dateFilter"
                        class="form-select"
                        style="width: 150px;">

                    <option value="">All Records</option>
                    <option value="asc">Oldest First</option>
                    <option value="desc">Newest First</option>

                </select>

                <select id="sortFilter"
                        class="form-select"
                        style="width: 130px;">

                    <option value="">Sort By</option>
                    <option value="asc">Ascending</option>
                    <option value="desc">Descending</option>

                </select>

                <div class="dropdown">

                    <button type="button"
                            class="btn dropdown-toggle"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                        Export
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end">

                        <li>
                            <button type="button"
                                    class="dropdown-item"
                                    id="exportPdf">
                                Export as PDF
                            </button>
                        </li>

                        <li>
                            <button type="button"
                                    class="dropdown-item"
                                    id="exportExcel">
                                Export as Excel
                            </button>
                        </li>

                    </ul>

                </div>

            </div>

        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table id="promotionTable"
                       class="table table-bordered table-hover align-middle w-100">

                    <thead class="table-light">

                        <tr>
                            <th>Employee Name</th>
                            <th>Designation From</th>
                            <th>Designation To</th>
                            <th>Promotion Date</th>
                            <th>Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    @if (item.User != null)
                                    {
                                        @item.User.FirstName @item.User.LastName
                                    }
                                </td>

                                <td>
                                    @item.DesignationFrom
                                </td>

                                <td>
                                    @item.DesignationTo
                                </td>

                                <td>
                                    @item.Date.ToString("yyyy-MM-dd")
                                </td>

                                <td>

                                    <button type="button"
                                            class="btn btn-sm editPromotionButton"
                                            data-id="@item.PromotionId"
                                            data-userid="@item.UserId"
                                            data-designationfrom="@item.DesignationFrom"
                                            data-designationto="@item.DesignationTo"
                                            data-date="@item.Date.ToString("yyyy-MM-dd")"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editPromotionModal"
                                            title="Edit">

                                        <i class="bi bi-pencil-square"></i>

                                    </button>

                                    <form asp-controller="Promotion"
                                          asp-action="DeletePromotion"
                                          asp-route-id="@item.PromotionId"
                                          method="post"
                                          style="display: inline;">

                                        <button type="submit"
                                                class="btn btn-sm"
                                                onclick="return confirm('Are you sure you want to delete this promotion?');"
                                                title="Delete">

                                            <i class="bi bi-trash"></i>

                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

<div class="modal fade"
     id="addPromotionModal"
     tabindex="-1"
     aria-labelledby="addPromotionModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title" id="addPromotionModalLabel">
                    Add Promotion
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <form asp-controller="Promotion"
                  asp-action="AddPromotion"
                  method="post">

                <div class="modal-body">

                    <div class="mb-3">

                        <label for="UserId" class="form-label">
                            Employee
                        </label>

                        <select id="UserId"
                                name="UserId"
                                class="form-select"
                                required>

                            <option value="">Select Employee</option>

                            @if (ViewBag.Users != null)
                            {
                                foreach (var user in ViewBag.Users)
                                {
                                    <option value="@user.Id">
                                        @user.FirstName @user.LastName
                                    </option>
                                }
                            }

                        </select>

                    </div>

                    <div class="mb-3">

                        <label for="DesignationFrom" class="form-label">
                            Designation From
                        </label>

                        <select id="DesignationFrom"
                                name="DesignationFrom"
                                class="form-select"
                                required>

                            <option value="">Select Designation</option>

                            @if (ViewBag.Designations != null)
                            {
                                foreach (var designation in ViewBag.Designations)
                                {
                                    <option value="@designation.DesignationName">
                                        @designation.DesignationName
                                    </option>
                                }
                            }

                        </select>

                    </div>

                    <div class="mb-3">

                        <label for="DesignationTo" class="form-label">
                            Designation To
                        </label>

                        <select id="DesignationTo"
                                name="DesignationTo"
                                class="form-select"
                                required>

                            <option value="">Select Designation</option>

                            @if (ViewBag.Designations != null)
                            {
                                foreach (var designation in ViewBag.Designations)
                                {
                                    <option value="@designation.DesignationName">
                                        @designation.DesignationName
                                    </option>
                                }
                            }

                        </select>

                    </div>

                    <div class="mb-3">

                        <label for="Date" class="form-label">
                            Promotion Date
                        </label>

                        <input type="date"
                               id="Date"
                               name="Date"
                               class="form-control"
                               required />

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn"
                            style="background-color: #F26522; color: white;">
                        Submit
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<div class="modal fade"
     id="editPromotionModal"
     tabindex="-1"
     aria-labelledby="editPromotionModalLabel"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title" id="editPromotionModalLabel">
                    Edit Promotion
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <form asp-controller="Promotion"
                  asp-action="EditPromotion"
                  method="post"
                  novalidate>

                <div class="modal-body">

                    <input type="hidden"
                           id="editPromotionId"
                           name="PromotionId" />

                    <div class="mb-3">

                        <label for="editPromotionUserId"
                               class="form-label">
                            Employee
                        </label>

                        <select id="editPromotionUserId"
                                name="UserId"
                                class="form-select">

                            <option value="">Select Employee</option>

                            @if (ViewBag.Users != null)
                            {
                                foreach (var user in ViewBag.Users)
                                {
                                    <option value="@user.Id">
                                        @user.FirstName @user.LastName
                                    </option>
                                }
                            }

                        </select>

                        <span class="text-danger">
                            @Html.ValidationMessage("UserId")
                        </span>

                    </div>

                    <div class="mb-3">

                        <label for="editDesignationFrom"
                               class="form-label">
                            Designation From
                        </label>

                        <select id="editDesignationFrom"
                                name="DesignationFrom"
                                class="form-select">

                            <option value="">Select Designation</option>

                            @if (ViewBag.Designations != null)
                            {
                                foreach (var designation in ViewBag.Designations)
                                {
                                    <option value="@designation.DesignationName">
                                        @designation.DesignationName
                                    </option>
                                }
                            }

                        </select>

                        <span class="text-danger">
                            @Html.ValidationMessage("DesignationFrom")
                        </span>

                    </div>

                    <div class="mb-3">

                        <label for="editDesignationTo"
                               class="form-label">
                            Designation To
                        </label>

                        <select id="editDesignationTo"
                                name="DesignationTo"
                                class="form-select">

                            <option value="">Select Designation</option>

                            @if (ViewBag.Designations != null)
                            {
                                foreach (var designation in ViewBag.Designations)
                                {
                                    <option value="@designation.DesignationName">
                                        @designation.DesignationName
                                    </option>
                                }
                            }

                        </select>

                        <span class="text-danger">
                            @Html.ValidationMessage("DesignationTo")
                        </span>

                    </div>

                    <div class="mb-3">

                        <label for="editPromotionDate"
                               class="form-label">
                            Promotion Date
                        </label>

                        <input type="date"
                               id="editPromotionDate"
                               name="Date"
                               class="form-control" />

                        <span class="text-danger">
                            @Html.ValidationMessage("Date")
                        </span>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn"
                            style="background-color: #F26522; color: white;">
                        Update Promotion
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>

    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>

    <script>

        $(document).ready(function () {

            var table = $('#promotionTable').DataTable({

                pageLength: 5,

                order: [[3, 'asc']],

                dom:
                    '<"row mb-3"<"col-md-6"l><"col-md-6"f>>' +
                    'rt' +
                    '<"row mt-3"<"col-md-6"i><"col-md-6"p>>',

                buttons: [

                    {
                        extend: 'excelHtml5',
                        title: 'Promotion List',
                        className: 'export-excel'
                    },

                    {
                        extend: 'pdfHtml5',
                        title: 'Promotion List',
                        orientation: 'landscape',
                        pageSize: 'A4',
                        className: 'export-pdf'
                    }

                ]

            });

            $('.dt-buttons').hide();

            $('#dateFilter').on('change', function () {

                var dateValue = $(this).val();

                if (dateValue !== '') {
                    table.order([3, dateValue]).draw();
                }

            });

            $('#sortFilter').on('change', function () {

                var sortValue = $(this).val();

                if (sortValue !== '') {
                    table.order([0, sortValue]).draw();
                }

            });

            $('#exportExcel').on('click', function () {

                table.button('.export-excel').trigger();

            });

            $('#exportPdf').on('click', function () {

                table.button('.export-pdf').trigger();

            });

            $('.editPromotionButton').on('click', function () {

                var id = $(this).data('id');
                var userid = $(this).data('userid');
                var designationfrom = $(this).data('designationfrom');
                var designationto = $(this).data('designationto');
                var date = $(this).data('date');

                $('#editPromotionId').val(id);
                $('#editPromotionUserId').val(userid);
                $('#editDesignationFrom').val(designationfrom);
                $('#editDesignationTo').val(designationto);
                $('#editPromotionDate').val(date);

            });

        });

    </script>
}