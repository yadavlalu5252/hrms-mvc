@model List<hrms_mvc.Models.EventTypes>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Event Types";
}


<div class="container-fluid mt-4">

    

    <h3 class="fw-bold mb-1">
        Holidays
    </h3>

    <div class="mb-4 text-secondary">
        Home / Event / Holidays List
    </div>


    <div class="row">

        

        <div class="col-md-6">

            <div class="card">

                <div class="card-header bg-white p-4">

                    <h5 class="fw-bold mb-0">
                        Add Event Type
                    </h5>

                </div>


                <div class="card-body p-4">

                    <form asp-controller="Event"
                          asp-action="AddMasterEvent"
                          method="post">


                    

                        <div class="mb-4">

                            <label class="form-label fw-bold">
                                Event Type Name
                            </label>

                            <input type="text"
                                   name="Name"
                                   class="form-control"
                                   required />

                        </div>


                      

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Color
                            </label>

                            <br />

                            <input type="color"
                                   id="eventColor"
                                   name="Colour"
                                   value="#563d7c"
                                   class="color-input" />

                            <div class="text-secondary mt-2">
                                Choose a color for this event type
                            </div>

                        </div>


                      

                        <button type="submit"
                                class="add-event-button">

                            <span class="me-1">⊕</span>

                            Add Event Type

                        </button>


                    </form>

                </div>

            </div>

        </div>



       

        <div class="col-md-6">

            <div class="card">

                <div class="card-header bg-white p-4">

                    <h5 class="fw-bold mb-0">
                        Existing Event Types
                    </h5>

                </div>


                <div class="card-body p-4">

                    <table id="eventTypeTable"
                           class="table">

                        <thead>

                            <tr>

                                <th>
                                    Name
                                </th>

                                <th>
                                    Color
                                </th>

                                <th>
                                    Sample
                                </th>

                                <th>
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <!-- NAME -->

                                    <td>
                                        @item.Name
                                    </td>


                                    <!-- COLOR -->

                                    <td>
                                        @item.Colour
                                    </td>


                                    <!-- COLOR SAMPLE -->

                                    <td>

                                        <div class="color-sample"
                                             style="background-color:@item.Colour">
                                        </div>

                                    </td>


                                    <!-- DELETE -->

                                    <td>

                                        <form asp-controller="Event"
                                              asp-action="DeleteMasterEvent"
                                              method="post">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.EventTypesId" />


                                            <button type="submit"
                                                    class="delete-button"
                                                    onclick="return confirm('Are you sure you want to delete this event type?')">

                                                Delete

                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>



<style>

    body {
        background-color: #f7f8f9;
    }


    /* CARD */

    .card {
        border: 1px solid #e1e4e8;
        border-radius: 6px;
    }


    .card-header {
        border-bottom: 1px solid #e1e4e8;
    }


  

    .form-control {
        height: 42px;
    }


    

    .color-input {
        width: 32px;
        height: 32px;
        border: none;
        padding: 0;
        cursor: pointer;
    }


    

    .add-event-button {
        background-color: #ff641f;
        color: white;
        border: none;
        padding: 10px 18px;
        border-radius: 5px;
        font-weight: 600;
    }


    

    #eventTypeTable thead th {
        background-color: #e5e7eb;
        padding: 12px 20px;
        border-bottom: 1px solid #6c757d;
    }


    

    #eventTypeTable tbody td {
        padding: 12px 20px;
        vertical-align: middle;
        color: #5f6b7a;
    }


    

    .color-sample {
        width: 32px;
        height: 32px;
        border-radius: 4px;
    }


    

    .delete-button {
        background-color: #dc3545;
        color: white;
        border: none;
        padding: 6px 12px;
        border-radius: 4px;
        cursor: pointer;
    }


    #eventTypeTable tbody tr:hover > * {
        background-color: transparent !important;
        box-shadow: none !important;
    }


 

    .add-event-button:hover {
        background-color: #ff641f;
        color: white;
    }


    .delete-button:hover {
        background-color: #dc3545;
        color: white;
    }

</style>