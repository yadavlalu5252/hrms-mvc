@model List<hrms_mvc.Models.Attendance>

@{
    ViewData["Title"] = "Employee Attendance";
    Layout = "~/Views/Shared/_EmployeeLayout.cshtml";

    var todayAttendance =
        ViewBag.TodayAttendance as hrms_mvc.Models.Attendance;

    var today = DateTime.Today;

    decimal workingHours = 0;
    decimal breakHours = 0;
    decimal productiveHours = 0;
    decimal overtimeHours = 0;

    if (todayAttendance != null)
    {
        if (todayAttendance.Checkin.HasValue)
        {
            var endTime =
                todayAttendance.Checkout ?? DateTime.Now;

            workingHours =
                Convert.ToDecimal(
                    (endTime - todayAttendance.Checkin.Value).TotalHours);
        }

        if (todayAttendance.Lunchout.HasValue)
        {
            var lunchEndTime =
                todayAttendance.Lunchin ?? DateTime.Now;

            breakHours =
                Convert.ToDecimal(
                    (lunchEndTime - todayAttendance.Lunchout.Value).TotalHours);
        }

        productiveHours =
            workingHours - breakHours;

        if (productiveHours < 0)
        {
            productiveHours = 0;
        }

        if (productiveHours > 8)
        {
            overtimeHours =
                productiveHours - 8;
        }
    }

    var weekStart =
        today.AddDays(-(int)today.DayOfWeek);

    var totalToday =
        Model?
            .Where(x => x.Date.Date == today)
            .Sum(x => x.WorkHours) ?? 0;

    var totalWeek =
        Model?
            .Where(x =>
                x.Date.Date >= weekStart &&
                x.Date.Date <= today)
            .Sum(x => x.WorkHours) ?? 0;

    var totalMonth =
        Model?
            .Where(x =>
                x.Date.Year == today.Year &&
                x.Date.Month == today.Month)
            .Sum(x => x.WorkHours) ?? 0;

    var totalOvertimeMonth =
        Model?
            .Where(x =>
                x.Date.Year == today.Year &&
                x.Date.Month == today.Month)
            .Sum(x => x.OTHours) ?? 0;

    var checkInHour = 0.0;
    var checkOutHour = 0.0;
    var lunchOutHour = 0.0;
    var lunchInHour = 0.0;

    if (todayAttendance?.Checkin != null)
    {
        checkInHour =
            todayAttendance.Checkin.Value.Hour +
            todayAttendance.Checkin.Value.Minute / 60.0;
    }

    if (todayAttendance?.Checkout != null)
    {
        checkOutHour =
            todayAttendance.Checkout.Value.Hour +
            todayAttendance.Checkout.Value.Minute / 60.0;
    }
    else if (todayAttendance?.Checkin != null)
    {
        checkOutHour =
            DateTime.Now.Hour +
            DateTime.Now.Minute / 60.0;
    }

    if (todayAttendance?.Lunchout != null)
    {
        lunchOutHour =
            todayAttendance.Lunchout.Value.Hour +
            todayAttendance.Lunchout.Value.Minute / 60.0;
    }

    if (todayAttendance?.Lunchin != null)
    {
        lunchInHour =
            todayAttendance.Lunchin.Value.Hour +
            todayAttendance.Lunchin.Value.Minute / 60.0;
    }
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<link rel="stylesheet"
      href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />

<style>
    .attendance-timeline {
        position: relative;
        width: 100%;
        height: 32px;
        margin-top: 20px;
        background: #e5e7eb;
        border-radius: 5px;
        overflow: hidden;
    }

    .attendance-segment {
        position: absolute;
        top: 0;
        height: 32px;
        border-radius: 5px;
    }

    .attendance-productive {
        background: #00c853;
    }

    .attendance-break {
        background: #ffbd00;
    }

    .attendance-overtime {
        background: #2785ff;
    }

    .attendance-time-labels {
        display: grid;
        grid-template-columns: repeat(18, minmax(0, 1fr));
        width: 100%;
        margin-top: 10px;
        color: #718096;
        font-size: 12px;
        white-space: nowrap;
    }

        .attendance-time-labels span {
            text-align: left;
        }
</style>

<div class="container-fluid bg-light min-vh-100 py-4">

    <div class="container-fluid">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>

                <h2 class="fw-bold text-primary mb-1">
                    Employee Attendance
                </h2>

                <p class="text-muted mb-0">
                    Employee / Attendance
                </p>

            </div>

            <div class="d-flex gap-2">

                <button type="button"
                        class="btn btn-outline-secondary">

                    <i class="bi bi-download me-1"></i>

                    Export

                </button>

                <button type="button"
                        class="btn btn-success">

                    <i class="bi bi-file-earmark-text me-1"></i>

                    Report

                </button>

            </div>

        </div>

        @if (TempData["success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show"
                 role="alert">

                <i class="bi bi-check-circle-fill me-2"></i>

                @TempData["success"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }

        <div class="row g-4 mb-4">

            <div class="col-xl-3 col-md-6">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body">

                        <div class="bg-success text-white rounded-3 p-2 d-inline-flex mb-3">

                            <i class="bi bi-clock fs-5"></i>

                        </div>

                        <h3 class="fw-bold text-primary mb-1">

                            @totalToday.ToString("0.00")

                        </h3>

                        <p class="text-muted mb-3">
                            Total Hours Today
                        </p>

                        <hr />

                        <span class="text-success">

                            <i class="bi bi-arrow-up-circle-fill me-1"></i>

                            Today

                        </span>

                    </div>

                </div>

            </div>

            <div class="col-xl-3 col-md-6">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body">

                        <div class="bg-dark text-white rounded-3 p-2 d-inline-flex mb-3">

                            <i class="bi bi-clock-history fs-5"></i>

                        </div>

                        <h3 class="fw-bold text-primary mb-1">

                            @totalWeek.ToString("0.00")

                        </h3>

                        <p class="text-muted mb-3">
                            Total Hours Week
                        </p>

                        <hr />

                        <span class="text-success">

                            <i class="bi bi-arrow-up-circle-fill me-1"></i>

                            This Week

                        </span>

                    </div>

                </div>

            </div>

            <div class="col-xl-3 col-md-6">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body">

                        <div class="bg-primary text-white rounded-3 p-2 d-inline-flex mb-3">

                            <i class="bi bi-calendar-check fs-5"></i>

                        </div>

                        <h3 class="fw-bold text-primary mb-1">

                            @totalMonth.ToString("0.00")

                        </h3>

                        <p class="text-muted mb-3">
                            Total Hours Month
                        </p>

                        <hr />

                        <span class="text-danger">

                            <i class="bi bi-arrow-down-circle-fill me-1"></i>

                            This Month

                        </span>

                    </div>

                </div>

            </div>

            <div class="col-xl-3 col-md-6">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body">

                        <div class="bg-danger text-white rounded-3 p-2 d-inline-flex mb-3">

                            <i class="bi bi-calendar-x fs-5"></i>

                        </div>

                        <h3 class="fw-bold text-primary mb-1">

                            @totalOvertimeMonth.ToString("0.00")

                        </h3>

                        <p class="text-muted mb-3">
                            Overtime this Month
                        </p>

                        <hr />

                        <span class="text-danger">

                            <i class="bi bi-arrow-down-circle-fill me-1"></i>

                            This Month

                        </span>

                    </div>

                </div>

            </div>

        </div>

        <div class="row g-4 mb-4">

            <div class="col-xl-3">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body text-center">

                        <h5 class="fw-bold text-primary mb-4">
                            Today's Attendance
                        </h5>

                        <div class="d-flex justify-content-center mb-3">

                            <div class="rounded-circle bg-light p-4">

                                <i class="bi bi-person-fill text-secondary display-4"></i>

                            </div>

                        </div>

                        <div class="bg-success text-white rounded-3 p-2 fw-bold mb-3">

                            Production :

                            @productiveHours.ToString("0.00")h

                        </div>

                        <p class="fw-semibold text-primary mb-4">

                            <i class="bi bi-fingerprint me-1"></i>

                            Punch In at

                            @(todayAttendance?.Checkin?.ToString("hh:mm tt")
                                ?? "Not Checked In")

                        </p>
                        @{
                            string attendanceAction = "";
                            string attendanceButton = "";
                            string attendanceButtonClass = "";
                            string attendanceIcon = "";

                            if (todayAttendance == null ||
                                todayAttendance.Checkin == null)
                            {
                                attendanceAction = "CheckIn";
                                attendanceButton = "Check-In";
                                attendanceButtonClass = "btn btn-success fw-bold px-4";
                                attendanceIcon = "bi bi-box-arrow-in-right";
                            }
                            else if (todayAttendance.Lunchout == null)
                            {
                                attendanceAction = "LunchOut";
                                attendanceButton = "Lunch-Out";
                                attendanceButtonClass = "btn btn-warning text-dark fw-bold px-4";
                                attendanceIcon = "bi bi-cup-hot";
                            }
                            else if (todayAttendance.Lunchin == null)
                            {
                                attendanceAction = "LunchIn";
                                attendanceButton = "Lunch-In";
                                attendanceButtonClass = "btn btn-primary fw-bold px-4";
                                attendanceIcon = "bi bi-cup-hot";
                            }
                            else if (todayAttendance.Checkout == null)
                            {
                                attendanceAction = "CheckOut";
                                attendanceButton = "Check-Out";
                                attendanceButtonClass = "btn btn-danger fw-bold px-4";
                                attendanceIcon = "bi bi-box-arrow-right";
                            }
                        }
                        @if (!string.IsNullOrEmpty(attendanceAction))
                        {
                            <form asp-controller="EmployeeAttendance"
                                  asp-action="@attendanceAction"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="@attendanceButtonClass">

                                    <i class="@attendanceIcon me-1"></i>

                                    @attendanceButton

                                </button>

                            </form>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn btn-secondary fw-bold px-4"
                                    disabled>

                                <i class="bi bi-check-circle-fill me-1"></i>

                                Attendance Marked

                            </button>
                        }
                    </div>

                </div>

            </div>

            <div class="col-xl-9">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body">

                        <div class="row g-3 mb-4">

                            <div class="col-md-3">

                                <span class="text-secondary">

                                    <i class="bi bi-circle-fill me-1"></i>

                                    Total Working hours

                                </span>

                                <h4 class="fw-bold text-primary mt-2">

                                    @workingHours.ToString("0.00") hrs

                                </h4>

                            </div>

                            <div class="col-md-3">

                                <span class="text-success">

                                    <i class="bi bi-circle-fill me-1"></i>

                                    Productive Hours

                                </span>

                                <h4 class="fw-bold text-primary mt-2">

                                    @productiveHours.ToString("0.00") hrs

                                </h4>

                            </div>

                            <div class="col-md-3">

                                <span class="text-warning">

                                    <i class="bi bi-circle-fill me-1"></i>

                                    Break hours

                                </span>

                                <h4 class="fw-bold text-primary mt-2">

                                    @breakHours.ToString("0.00") hrs

                                </h4>

                            </div>

                            <div class="col-md-3">

                                <span class="text-primary">

                                    <i class="bi bi-circle-fill me-1"></i>

                                    Overtime

                                </span>

                                <h4 class="fw-bold text-primary mt-2">

                                    @overtimeHours.ToString("0.00") hrs

                                </h4>

                            </div>

                        </div>

                        <div class="attendance-timeline">

                            <div class="attendance-segment attendance-productive"
                                 style="left:20%; width:22%;">
                            </div>

                            <div class="attendance-segment attendance-break"
                                 style="left:42%; width:7%;">
                            </div>

                            <div class="attendance-segment attendance-productive"
                                 style="left:49%; width:25%;">
                            </div>

                            <div class="attendance-segment attendance-overtime"
                                 style="left:74%; width:10%;">
                            </div>

                        </div>

                        <div class="attendance-time-labels">
                            <span>06:00</span>
                            <span>07:00</span>
                            <span>08:00</span>
                            <span>09:00</span>
                            <span>10:00</span>
                            <span>11:00</span>
                            <span>12:00</span>
                            <span>01:00</span>
                            <span>02:00</span>
                            <span>03:00</span>
                            <span>04:00</span>
                            <span>05:00</span>
                            <span>06:00</span>
                            <span>07:00</span>
                            <span>08:00</span>
                            <span>09:00</span>
                            <span>10:00</span>
                            <span>11:00</span>
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="card border-0 shadow-sm">

            <div class="card-header bg-white border-0 py-3">

                <div class="row align-items-end g-3">

                    <div class="col-lg-4">

                        <h5 class="fw-bold text-primary mb-0">
                            Employee Attendance
                        </h5>

                    </div>

                    <div class="col-lg-2">

                        <label class="form-label fw-semibold">
                            Start
                        </label>

                        <input type="date"
                               id="startDate"
                               class="form-control" />

                    </div>

                    <div class="col-lg-2">

                        <label class="form-label fw-semibold">
                            End
                        </label>

                        <input type="date"
                               id="endDate"
                               class="form-control" />

                    </div>

                    <div class="col-lg-2">

                        <label class="form-label fw-semibold">
                            Status
                        </label>

                        <select id="statusFilter"
                                class="form-select">

                            <option value="">
                                Select Status
                            </option>

                            <option value="Present">
                                Present
                            </option>

                            <option value="Absent">
                                Absent
                            </option>

                            <option value="Late">
                                Late
                            </option>

                            <option value="Half Day">
                                Half Day
                            </option>

                        </select>

                    </div>

                </div>

            </div>

            <div class="card-body">

                <div class="table-responsive">

                    <table id="attendanceTable"
                           class="table table-bordered table-hover align-middle w-100">

                        <thead class="table-light">

                            <tr>

                                <th>Date</th>

                                <th>Check In</th>

                                <th>Status</th>

                                <th>Check Out</th>

                                <th>Break</th>

                                <th>Late</th>

                                <th>Overtime</th>

                                <th>Production Hours</th>

                            </tr>

                        </thead>

                        <tbody>

                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <tr>

                                        <td>
                                            @item.Date.ToString("yyyy-MM-dd")
                                        </td>

                                        <td>
                                            @(item.Checkin?.ToString("hh:mm tt") ?? "-")
                                        </td>

                                        <td>

                                            @if (item.Status == "Present")
                                            {
                                                <span class="badge bg-success">

                                                    <i class="bi bi-circle-fill me-1"></i>

                                                    Present

                                                </span>
                                            }
                                            else if (item.Status == "Absent")
                                            {
                                                <span class="badge bg-danger">

                                                    <i class="bi bi-circle-fill me-1"></i>

                                                    Absent

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">

                                                    @item.Status

                                                </span>
                                            }

                                        </td>

                                        <td>
                                            @(item.Checkout?.ToString("hh:mm tt") ?? "-")
                                        </td>

                                        <td>
                                            @item.BreakHours.ToString("0.00") hrs
                                        </td>

                                        <td>
                                            @item.Late min
                                        </td>

                                        <td>
                                            @item.OTHours.ToString("0.00") hrs
                                        </td>

                                        <td>

                                            @if (item.ProdHours > 0)
                                            {
                                                <span class="badge bg-success">

                                                    @item.ProdHours.ToString("0.00")

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">

                                                    0.00

                                                </span>
                                            }

                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>

                                    <td colspan="8"
                                        class="text-center text-muted py-4">

                                        No attendance records found.

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>

    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>

    <script>

            document.addEventListener("DOMContentLoaded", function () {

                if ($.fn.DataTable) {

                    const table =
                        $("#attendanceTable").DataTable({

                            pageLength: 10,

                            lengthMenu: [
                                [5, 10, 25, 50],
                                [5, 10, 25, 50]
                            ],

                            ordering: true,

                            searching: true,

                        responsive: true,

                        language: {

                            search: "Search:",

                            lengthMenu:
                                    "Show _MENU_ entries",

                                info:
                                "Showing _START_ to _END_ of _TOTAL_ entries",

                            emptyTable:
                                    "No attendance records found."

                            }

                        });

                    $("#statusFilter").on(
                    "change",
                    function () {

                        table
                                .column(2)
                            .search($(this).val())
                            .draw();

                    }
                );

                $.fn.dataTable.ext.search.push(

                    function (
                        settings,
                            data,
                        dataIndex
                        ) {

                            if (
                                settings.nTable.id !==
                            "attendanceTable"
                            ) {
                            return true;
                        }

                        const date =
                                data[0];

                            const startDate =
                                $("#startDate").val();

                            const endDate =
                            $("#endDate").val();

                        if (!date) {
                            return true;
                            }

                        if (
                                startDate &&
                            date < startDate
                        ) {
                                return false;
                        }

                        if (
                                endDate &&
                            date > endDate
                        ) {
                            return false;
                            }

                        return true;

                        }

                    );

                    $("#startDate, #endDate").on(
                    "change",
                        function () {

                        table.draw();

                    }
                    );

                }

        });

    </script>
}