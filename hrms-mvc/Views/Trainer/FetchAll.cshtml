@model IEnumerable<hrms_mvc.Models.Trainers>

<div class="main-wrapper">

    <div class="card p-4">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <h3 class="mb-0">Trainer List</h3>

            <a asp-controller="Trainer"
               asp-action="AddTrainers"
               class="btn btn-primary">
                Add Trainer
            </a>

        </div>


        <div class="table-responsive">

            <table id="trainersTable"
                   class="table table-bordered table-hover">

                <thead>

                    <tr>

                        <th>Id</th>
                        <th>Profile Picture</th>
                        <th>Name</th>
                        <th>Role</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th>Action</th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var d in Model)
                    {
                        <tr>

                            <td>
                                @d.Id
                            </td>

                            <td>

                                @if (!string.IsNullOrEmpty(d.ProfilePicture))
                                {
                                    <img src="~/Content/uploads/@d.ProfilePicture"
                                         width="60"
                                         height="60"
                                         style="object-fit:cover;" />
                                }

                            </td>

                            <td>
                                @d.Fname @d.Lname
                            </td>

                            <td>
                                @d.Role
                            </td>

                            <td>
                                @d.Email
                            </td>

                            <td>
                                @d.Phone
                            </td>

                            <td>
                                @d.Description
                            </td>

                            <td>
                                @d.Status
                            </td>

                            <td>

                                <a asp-controller="Trainer"
                                   asp-action="EditTrainer"
                                   asp-route-id="@d.Id"
                                   class="btn btn-warning btn-sm">
                                    Edit
                                </a>


                                <form asp-controller="Trainer"
                                      asp-action="DeleteTrainer"
                                      asp-route-id="@d.Id"
                                      method="post"
                                      style="display:inline;">

                                    <button type="submit"
                                            class="btn btn-danger btn-sm">
                                        Delete
                                    </button>

                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


@section Scripts {

    <script src="https://cdn.datatables.net/1.13.5/js/jquery.dataTables.min.js"></script>

    <script>

        $(document).ready(function() {

            $('#trainersTable').DataTable({
                pageLength: 10
            });

        });

    </script>

}